<!--
=============================================================================
REMOVE SCRIPT
=============================================================================
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
#!/bin/bash

PLUGIN_NAME="homepage-labels"
PLUGIN_DIR="/usr/local/emhttp/plugins/${PLUGIN_NAME}"

echo "-----------------------------------------------------------"
echo " Homepage Label Manager — Removing..."
echo "-----------------------------------------------------------"

# Remove plugin files (preserve user config on boot drive)
rm -rf "${PLUGIN_DIR}"

# Remove temp files
rm -rf "/tmp/homepage-labels"

echo " Plugin files removed."
echo " User settings preserved at /boot/config/plugins/${PLUGIN_NAME}/"
echo " To fully remove, also delete: /boot/config/plugins/${PLUGIN_NAME}/"
echo "-----------------------------------------------------------"
</INLINE>
</FILE>

</PLUGIN>
