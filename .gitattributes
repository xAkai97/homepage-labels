# Set default behavior to normalize line endings to LF (mandatory for Unraid/Linux)
* text=auto eol=lf

# Explicitly enforce LF line endings on all Unraid & shell scripts
*.sh text eol=lf
docker_container_created text eol=lf
src/usr/local/emhttp/plugins/homepage-labels/event/* text eol=lf

# Force LF on plugin manifest, PHP source, and Dynamix page templates
*.plg text eol=lf
*.php text eol=lf
*.page text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.cfg text eol=lf
*.md text eol=lf

# Windows PowerShell test runner
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.txz binary

