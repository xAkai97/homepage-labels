<script>
function homepagePreviewScale(scale) {
    $('.homepage-root')
        .removeClass('homepage-scale-100 homepage-scale-110 homepage-scale-125 homepage-scale-140')
        .addClass('homepage-scale-' + scale);
}

$(function() {
    function homepageResolveCsrfToken() {
        var existing = $('#settings-csrf-token').val();
        if (existing) return existing;
        if (typeof csrf_token !== 'undefined' && csrf_token) return csrf_token;
        if (window.csrf_token) return window.csrf_token;
        if (typeof $.cookie === 'function') {
            var c = $.cookie('csrf_token');
            if (c) return c;
        }
        var m = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/);
        return m ? decodeURIComponent(m[1]) : '';
    }

    var token = homepageResolveCsrfToken();
    if (token) {
        if (!$('#settings-csrf-token').val()) {
            $('#settings-csrf-token').val(token);
        }
        $('input[name="csrf_token"]').each(function() {
            if (!$(this).val()) $(this).val(token);
        });
    }

    $('form').on('submit', function() {
        var $tInput = $(this).find('input[name="csrf_token"]');
        if ($tInput.length && !$tInput.val()) {
            var t = homepageResolveCsrfToken();
            if (t) $tInput.val(t);
        }
    });
});
</script>
