<?php
/**
 * HomepageLabelsSettings.page — Global Plugin Settings
 *
 * Provides configuration for:
 * - Base host/scheme for URL generation
 * - Internal URL mode (host_port vs container_network)
 * - Default masking behavior
 * - Homepage container name for health checks
 * - Backup settings
 */

require_once '/usr/local/emhttp/plugins/homepage-labels/include/preset_engine.php';
require_once '/usr/local/emhttp/plugins/homepage-labels/include/view_components.php';

// Ensure Unraid emhttp runtime variables are initialized
if (!isset($var) || !is_array($var)) {
    if (isset($GLOBALS['var']) && is_array($GLOBALS['var'])) {
        $var = &$GLOBALS['var'];
    } elseif (file_exists('/var/local/emhttp/var.ini')) {
        $var = @parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW) ?: [];
    } else {
        $var = [];
    }
}
if (session_status() === PHP_SESSION_NONE) {
    @session_start();
}
if (empty($var['csrf_token'])) {
    $var['csrf_token'] = $GLOBALS['var']['csrf_token']
        ?? $_SESSION['csrf_token']
        ?? (file_exists('/var/local/emhttp/var.ini') ? (@parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW)['csrf_token'] ?? null) : null)
        ?? $_COOKIE['csrf_token']
        ?? '';
}

$settingsPath = defined('PLUGIN_SETTINGS_PATH') ? PLUGIN_SETTINGS_PATH : '/boot/config/plugins/homepage-labels/settings.cfg';
$defaults = getDefaultPluginSettings();

// Load current settings
$settings = loadPluginSettings($settingsPath);

// Handle Support Bundle Download
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'download_support_bundle') {
    $sessionToken = $var['csrf_token']
        ?? $GLOBALS['var']['csrf_token']
        ?? $_SESSION['csrf_token']
        ?? (file_exists('/var/local/emhttp/var.ini') ? (@parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW)['csrf_token'] ?? null) : null)
        ?? $_COOKIE['csrf_token']
        ?? null;
    $providedToken = $_POST['csrf_token'] ?? '';
    if (empty($sessionToken) || empty($providedToken) || !hash_equals((string)$sessionToken, (string)$providedToken)) {
        http_response_code(403);
        echo 'Invalid CSRF token.';
        exit;
    }

    require_once '/usr/local/emhttp/plugins/homepage-labels/include/xml_parser.php';
    $bundleData = [
        'generated_at'   => date('Y-m-d H:i:s'),
        'plugin_version' => '2026.10.31',
        'php_version'    => PHP_VERSION,
        'os'             => PHP_OS,
        'settings'       => $settings,
        'user_templates' => loadUserTemplates(),
        'templates_meta' => [],
    ];

    $allTemplates = listAllTemplates();
    foreach ($allTemplates as $t) {
        $tName = is_array($t) ? ($t['name'] ?? '') : $t;
        if (empty($tName)) continue;
        $readRes = readTemplate($tName);
        if ($readRes['success']) {
            $meta = getContainerMeta($readRes['doc']);
            $labels = getHomepageLabels($readRes['doc']);
            foreach ($labels as $tgt => &$lData) {
                if (isMaskTrue($lData['mask'] ?? false) || strpos($tgt, 'key') !== false || strpos($tgt, 'password') !== false || strpos($tgt, 'token') !== false) {
                    $lData['value'] = '***REDACTED***';
                }
            }
            $bundleData['templates_meta'][$tName] = [
                'meta'   => $meta,
                'labels' => $labels,
            ];
        }
    }

    while (ob_get_level() > 0) {
        ob_end_clean();
    }
    header('Content-Type: application/json; charset=utf-8');
    header('Content-Disposition: attachment; filename="homepage-labels-support-bundle-' . date('Ymd-His') . '.json"');
    echo json_encode($bundleData, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    exit;
}

// Handle form POST
$saved = false;
$saveError = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'save_settings') {
    $sessionToken = $var['csrf_token']
        ?? $GLOBALS['var']['csrf_token']
        ?? $_SESSION['csrf_token']
        ?? (file_exists('/var/local/emhttp/var.ini') ? (@parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW)['csrf_token'] ?? null) : null)
        ?? $_COOKIE['csrf_token']
        ?? null;
    $providedToken = $_POST['csrf_token'] ?? '';
    if (empty($sessionToken) || empty($providedToken) || !hash_equals((string)$sessionToken, (string)$providedToken)) {
        $saveError = 'Invalid CSRF token. Please refresh the page and try again.';
    }

    if (empty($saveError)) {
        $newSettings = [];
        foreach ($defaults as $key => $default) {
            $newSettings[$key] = isset($_POST[$key]) ? trim($_POST[$key]) : $default;
        }

        // Validate BASE_HOST
        if (empty($newSettings['BASE_HOST'])) {
            $httpHost = $_SERVER['HTTP_HOST'] ?? '';
            $newSettings['BASE_HOST'] = explode(':', $httpHost)[0] ?: ($_SERVER['SERVER_ADDR'] ?? '');
        }

        // Write settings file using safe serializer
        if (savePluginSettings($newSettings, $settingsPath)) {
            $settings = $newSettings;
            $saved = true;
        } else {
            $saveError = 'Failed to write settings file.';
        }
    }
}

// Health check (if validator available)
$healthData = [
    'containerName' => $settings['HOMEPAGE_CONTAINER_NAME'],
    'running'       => false,
    'socketMounted' => false,
];

$validatorPath = '/usr/local/emhttp/plugins/homepage-labels/scripts/validator.php';
if (file_exists($validatorPath)) {
    require_once $validatorPath;
    $healthData = validateHomepageSetup($settings['HOMEPAGE_CONTAINER_NAME']);
}
$fontScale = $settings['UI_FONT_SCALE'] ?? '100';
?>

