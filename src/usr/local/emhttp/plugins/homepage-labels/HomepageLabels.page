/**
 * Save current active editor form values as a new custom template.
 */
function homepageSaveCurrentAsTemplate() {
    var templateName = prompt('Enter a name for this custom template:');
    if (!templateName || !templateName.trim()) return;

    var fields = {};
    $('#homepage-editor-form').find('input[name^="labels["]:not(:disabled), select[name^="labels["]:not(:disabled)').each(function() {
        var match = $(this).attr('name').match(/labels\[([^\]]+)\]/);
        if (match && $(this).val()) {
            var targetKey = match[1];
            var $row = $(this).closest('.homepage-field-row');
            var isMasked = $row.find('input[type="checkbox"][name^="masks"]').is(':checked') ? 'true' : 'false';
            var fieldEntry = {
                value: $(this).val(),
                mask: isMasked,
                active: true
            };
            var $drawer = $row.find('.homepage-field-config-drawer');
            if ($drawer.length) {
                var cName = $drawer.find('.cfg-attr-name').val();
                var cDef = $drawer.find('.cfg-attr-default').val();
                var cDesc = $drawer.find('.cfg-attr-description').val();
                var cDisp = $drawer.find('.cfg-attr-display').val();
                var cReq = $drawer.find('.cfg-attr-required').val();

                if (cName) fieldEntry.name = cName;
                if (typeof cDef !== 'undefined') fieldEntry.default = cDef;
                if (cDesc) fieldEntry.description = cDesc;
                if (cDisp) fieldEntry.display = cDisp;
                if (cReq) fieldEntry.required = cReq;
            }
            fields[targetKey] = fieldEntry;
        }
    });

    var payload = {
        action: 'template_save',
        name: templateName.trim(),
        widget_enabled: $('#enable-widget').is(':checked') ? '1' : '0',
        fields: fields
    };
    var token = homepageGetCsrfToken();
    if (token) payload.csrf_token = token;

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp.success) {
            homepageShowNotification('success', 'Template saved: ' + templateName);
            homepageRefreshTemplateLists(resp.id);
