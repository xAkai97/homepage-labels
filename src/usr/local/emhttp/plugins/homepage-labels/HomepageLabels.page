/**
 * Auto-detect secret custom keys (e.g. key, token, secret, password) and enable masking.
 */
function homepageOnCustomKeyInput(input) {
    var $keyInput = $(input);
    var key = ($keyInput.val() || '').toLowerCase();
    var $row = $keyInput.closest('.homepage-custom-row');
    var $cb = $row.find('.custom-mask');

    var secretKeywords = /(key|token|secret|password|passwd|pass|auth|api_key|apikey)/i;
    if (secretKeywords.test(key) && !$cb.is(':checked') && !$cb.data('user-untoggled')) {
        $cb.prop('checked', true);
        homepageOnCustomMaskChange($cb[0]);
    }
}

