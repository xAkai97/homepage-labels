    .homepage-quickfill-chip:hover {
        background: rgba(230, 81, 0, 0.12);
        color: #e65100;
        border-color: rgba(230, 81, 0, 0.4);
    }
    .homepage-quickfill-val {
        font-family: Consolas, "Courier New", monospace !important;
        font-size: 0.92em;
        background: rgba(120, 120, 120, 0.14);
        padding: 0.1em 0.45em;
        border-radius: 3px;
        color: inherit;
        border: 1px solid rgba(120, 120, 120, 0.18);
    }
    .homepage-quickfill-chip:hover .homepage-quickfill-val {
        border-color: rgba(230, 81, 0, 0.35);
        background: rgba(230, 81, 0, 0.12);
        color: #e65100;
    }

    /* --- Template Toolbar --- */
    .homepage-template-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.8em 1.2em;
        padding: 0.85em 1.2em;
        border-radius: 0.65em;
        border: 1px solid rgba(120, 120, 120, 0.25);
        background: rgba(120, 120, 120, 0.06);
        margin-bottom: 1.5em;
        flex-wrap: wrap;
    }
    .homepage-template-group {
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
        flex-wrap: nowrap;
        vertical-align: middle;
    }
    select.homepage-template-select {
        background: rgba(120, 120, 120, 0.1) !important;
        border: 1px solid rgba(120, 120, 120, 0.35) !important;
        border-radius: 0.4em !important;
        color: inherit !important;
        padding: 0.45em 0.8em !important;
        font-size: 0.92em !important;
        height: auto !important;
        line-height: 1.35 !important;
        max-width: 15.5em;
        box-sizing: border-box !important;
        vertical-align: middle !important;
    }
    select.homepage-template-select:focus {
        border-color: #e65100 !important;
        outline: none;
    }

    html.black select.homepage-template-select,
    body.dark select.homepage-template-select,
    html.dark select.homepage-template-select {
        background: #242424 !important;
        color: #eeeeee !important;
        border-color: #444444 !important;
    }

    /* --- Subsection Titles --- */
    .homepage-subsection-title {
        font-weight: 600;
        font-size: 0.95em;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.85;
        margin: 1.2em 0 0.8em 0;
        padding-bottom: 0.4em;
        border-bottom: 1px solid rgba(120, 120, 120, 0.15);
        display: flex;
        align-items: center;
        gap: 0.55em;
    }

    /* --- Homepage Live Card Mockup --- */
    .homepage-mockup-wrapper {
        background: rgba(120, 120, 120, 0.06);
        border: 1px solid rgba(120, 120, 120, 0.22);
        border-radius: 0.65em;
        padding: 0.9em 1.2em;
        margin-bottom: 0.8em;
    }
    .homepage-mockup-header-label {
        font-size: 0.88em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.8;
        margin-bottom: 0.7em;
        display: flex;
        align-items: center;
        gap: 0.45em;
    }
    .homepage-mockup-board {
        display: flex;
        flex-direction: column;
        gap: 0.4em;
    }
    .homepage-mockup-group-title {
        font-size: 0.88em;
        font-weight: 600;
        opacity: 0.75;
        letter-spacing: 0.3px;
        display: flex;
        align-items: center;
        gap: 0.45em;
    }
    .homepage-mockup-card {
        background: var(--bg-level-1, rgba(120, 120, 120, 0.1));
        border: 1px solid rgba(120, 120, 120, 0.3);
        border-radius: 0.6em;
        padding: 0.85em 1.1em;
        max-width: 25em;
        box-shadow: 0 0.15em 0.5em rgba(0, 0, 0, 0.12);
        display: flex;
        flex-direction: column;
        gap: 0.65em;
    }
    .homepage-mockup-card-body {
        display: flex;
        align-items: center;
        gap: 0.85em;
    }
    .homepage-mockup-icon-wrap {
        width: 2.5em;
        height: 2.5em;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(120, 120, 120, 0.08);
        border-radius: 0.45em;
        flex-shrink: 0;
        overflow: hidden;
    }
    .homepage-mockup-icon {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .homepage-mockup-icon-fallback {
        font-size: 1.3em;
        opacity: 0.5;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .homepage-mockup-info {
        display: flex;
        flex-direction: column;
        gap: 0.15em;
        min-width: 0;
        flex: 1;
    }
    .homepage-mockup-title-row {
        display: flex;
        align-items: center;
        gap: 0.55em;
    }
    .homepage-mockup-title {
        font-weight: 700;
        font-size: 1.05em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .homepage-mockup-status-dot {
        width: 0.6em;
        height: 0.6em;
        border-radius: 50%;
        background: #2ecc71;
        box-shadow: 0 0 0.4em rgba(46, 204, 113, 0.65);
        display: inline-block;
        flex-shrink: 0;
    }
    .homepage-mockup-desc {
        font-size: 0.84em;
        opacity: 0.72;
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .homepage-mockup-widget {
        border-top: 1px solid rgba(120, 120, 120, 0.15);
        padding-top: 0.55em;
        display: flex;
        flex-direction: column;
        gap: 0.35em;
    }
    .homepage-mockup-widget-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .homepage-mockup-widget-type {
        font-size: 0.78em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: #29b6f6;
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
    }
    .homepage-mockup-widget-live-dot {
        width: 0.45em;
        height: 0.45em;
        border-radius: 50%;
        background: #29b6f6;
    }
    .homepage-mockup-widget-stats {
        display: flex;
        align-items: center;
        gap: 0.45em;
        flex-wrap: wrap;
    }
    .homepage-mockup-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-size: 0.76em;
        padding: 0.18em 0.5em;
        border-radius: 0.3em;
        background: rgba(120, 120, 120, 0.14);
        border: 1px solid rgba(120, 120, 120, 0.22);
    }
    .homepage-mockup-stat-pill .stat-lbl {
        opacity: 0.65;
    }
    .homepage-mockup-stat-pill .stat-val {
        font-weight: 600;
    }

    /* --- Live Preview & Code Block --- */
    .homepage-preview-container {
        display: flex;
        flex-direction: column;
        gap: 0.8em;
    }
    .homepage-preview-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8em;
    }
    .homepage-preview-mode-title {
        font-size: 0.94em;
        font-weight: 600;
        opacity: 0.85;
    }
    .homepage-preview-actions {
        display: flex;
        gap: 0.55em;
    }
    .homepage-code-block {
        margin: 0;
        padding: 1.1em 1.35em;
        border-radius: 0.55em;
        background: #1e1e1e;
        color: #d4d4d4;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.94em;
        line-height: 1.6;
        overflow-x: auto;
        border: 1px solid rgba(120, 120, 120, 0.3);
        max-height: 22em;
        tab-size: 2;
    }

    /* --- Actions Bar --- */
    .homepage-actions-bar {
        position: sticky;
        bottom: 0;
        z-index: 50;
        background: var(--background-color, #1e1e1e);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.8em;
        margin-top: 1.6em;
        padding: 1em 1.2em;
        border-top: 1px solid var(--line-color, rgba(120, 120, 120, 0.25));
        border-radius: 0 0 6px 6px;
        box-shadow: 0 -4px 14px rgba(0, 0, 0, 0.12);
        flex-wrap: wrap;
    }
    .homepage-actions-bar input[type="button"],
    .homepage-actions-bar button {
        padding: 0.6em 1.5em !important;
        font-size: 0.96em !important;
        border-radius: 0.4em !important;
        cursor: pointer !important;
        font-weight: 600 !important;
    }

    /* --- Icon Browser Modal --- */
    .homepage-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(4px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5em;
        box-sizing: border-box;
    }
    .homepage-modal-dialog {
        background: var(--background-color, #242424);
        color: var(--text-color, #e0e0e0);
        border: 1px solid var(--line-color, rgba(120, 120, 120, 0.35));
        border-radius: 0.75em;
        width: 100%;
        max-width: 58em;
        height: 85vh;
        max-height: 52em;
        display: flex;
        flex-direction: column;
        box-shadow: 0 1.2em 3.5em rgba(0, 0, 0, 0.65);
        overflow: hidden;
        animation: homepageModalFadeIn 0.18s ease-out;
    }
    @keyframes homepageModalFadeIn {
        from { opacity: 0; transform: scale(0.96); }
        to { opacity: 1; transform: scale(1); }
    }
    .homepage-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1em 1.4em;
        border-bottom: 1px solid var(--line-color, rgba(120, 120, 120, 0.2));
        background: rgba(120, 120, 120, 0.06);
    }
    .homepage-modal-title-wrap {
        display: flex;
        align-items: center;
        gap: 0.75em;
    }
    .homepage-modal-icon {
        font-size: 1.3em;
        color: #e65100;
    }
    .homepage-modal-title {
        margin: 0;
        font-size: 1.2em;
        font-weight: 600;
        letter-spacing: -0.01em;
    }
    .homepage-modal-close {
        background: transparent;
        border: none;
        font-size: 1.6em;
        line-height: 1;
        cursor: pointer;
        opacity: 0.6;
        color: inherit;
        padding: 0.1em 0.3em;
        border-radius: 0.2em;
        transition: opacity 0.12s ease;
    }
    .homepage-modal-close:hover {
        opacity: 1;
        color: #e53935;
    }
    .homepage-modal-toolbar {
        padding: 0.9em 1.4em;
        border-bottom: 1px solid var(--line-color, rgba(120, 120, 120, 0.18));
        display: flex;
        flex-direction: column;
        gap: 0.7em;
        background: rgba(120, 120, 120, 0.03);
    }
    .homepage-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 1.2em 1.4em;
        position: relative;
    }
    .homepage-modal-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9em 1.4em;
        border-top: 1px solid var(--line-color, rgba(120, 120, 120, 0.2));
        background: rgba(120, 120, 120, 0.05);
    }

    /* --- Bulk Operations Toolbar --- */
    .homepage-bulk-toolbar {
        position: sticky;
        top: 10px;
        z-index: 100;
        margin-bottom: 1.2em;
        animation: homepageSlideDown 0.2s ease-out;
    }
    @keyframes homepageSlideDown {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .homepage-bulk-toolbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1em;
        background: var(--background-color, #242424);
        border: 1px solid #e65100;
        box-shadow: 0 0.5em 1.8em rgba(0, 0, 0, 0.45);
        border-radius: 0.65em;
        padding: 0.65em 1.2em;
        flex-wrap: wrap;
    }
    .homepage-bulk-info {
        display: flex;
        align-items: center;
        gap: 0.5em;
        font-weight: 600;
        font-size: 0.96em;
    }
    .homepage-bulk-count {
        background: #e65100;
        color: #fff;
        padding: 0.15em 0.6em;
        border-radius: 1em;
        font-size: 0.9em;
    }
    .homepage-bulk-actions {
        display: flex;
        align-items: center;
        gap: 0.55em;
        flex-wrap: wrap;
    }
    .homepage-btn--bulk {
        background: rgba(120, 120, 120, 0.12) !important;
        border: 1px solid var(--line-color, rgba(120, 120, 120, 0.35)) !important;
        color: inherit !important;
        padding: 0.4em 0.9em !important;
        font-size: 0.88em !important;
        border-radius: 0.35em !important;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        font-weight: 600;
        transition: all 0.12s ease;
    }
    .homepage-btn--bulk:hover {
        background: rgba(120, 120, 120, 0.22) !important;
        border-color: rgba(120, 120, 120, 0.5) !important;
    }
    .homepage-btn--bulk-enable {
        border-color: rgba(39, 174, 96, 0.45) !important;
        color: #27ae60 !important;
    }
    .homepage-btn--bulk-enable:hover {
        background: rgba(39, 174, 96, 0.18) !important;
        border-color: #27ae60 !important;
    }
    .homepage-btn--bulk-disable {
        border-color: rgba(229, 57, 53, 0.45) !important;
        color: #e53935 !important;
    }
    .homepage-btn--bulk-disable:hover {
        background: rgba(229, 57, 53, 0.18) !important;
        border-color: #e53935 !important;
    }
    .homepage-btn--bulk-recreate {
        border-color: rgba(230, 81, 0, 0.55) !important;
        color: #e65100 !important;
    }
    .homepage-btn--bulk-recreate:hover {
        background: rgba(230, 81, 0, 0.18) !important;
        border-color: #e65100 !important;
    }
    .homepage-btn--bulk-clear {
        background: transparent !important;
        border: none !important;
        color: inherit !important;
        opacity: 0.65;
        padding: 0.4em 0.6em !important;
        font-size: 0.86em !important;
        cursor: pointer;
    }
    .homepage-btn--bulk-clear:hover {
        opacity: 1;
        text-decoration: underline;
    }
    tr.homepage-row--selected {
        background: rgba(230, 81, 0, 0.09) !important;
    }
    .homepage-select-all-cb,
    .homepage-row-select {
        cursor: pointer;
        accent-color: #e65100;
        width: 1.15em;
        height: 1.15em;
        margin: 0;
        vertical-align: middle;
    }
    .homepage-btn--test-conn {
        background: rgba(255, 152, 0, 0.15) !important;
        border: 1px solid #ff9800 !important;
        color: #ff9800 !important;
        padding: 0.3em 0.7em !important;
        font-size: 0.85em !important;
        border-radius: 0.3em !important;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-weight: 600;
        transition: all 0.15s ease;
    }
    .homepage-btn--test-conn:hover {
        background: rgba(255, 152, 0, 0.28) !important;
    }
    .homepage-test-status {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        font-size: 0.86em;
        font-weight: 600;
        padding: 0.2em 0.55em;
        border-radius: 0.3em;
        transition: opacity 0.2s ease;
    }
    .homepage-test-status--ok {
        background: rgba(39, 174, 96, 0.15);
        color: #27ae60;
        border: 1px solid rgba(39, 174, 96, 0.4);
    }
    .homepage-test-status--error {
        background: rgba(231, 76, 60, 0.15);
        color: #e74c3c;
        border: 1px solid rgba(231, 76, 60, 0.4);
    }
    .homepage-test-status--loading {
        background: rgba(52, 152, 219, 0.15);
        color: #3498db;
        border: 1px solid rgba(52, 152, 219, 0.4);
    }

    /* --- Pre-Save Diff & Recreate Warning Modal --- */
    .homepage-diff-warning-banner {
        display: flex;
        align-items: flex-start;
        gap: 0.85em;
        background: rgba(230, 126, 34, 0.12);
        border: 1px solid rgba(230, 126, 34, 0.4);
        border-radius: 0.45em;
        padding: 0.85em 1em;
        margin-bottom: 1.1em;
        font-size: 0.93em;
        line-height: 1.5;
        color: inherit;
    }
    .homepage-diff-warning-banner i {
        color: #e67e22;
        font-size: 1.35em;
        margin-top: 0.1em;
        flex-shrink: 0;
    }
    .homepage-diff-metrics-bar {
        display: flex;
        gap: 0.6em;
        margin-bottom: 1em;
        flex-wrap: wrap;
    }
    .homepage-diff-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
        padding: 0.3em 0.75em;
        border-radius: 1em;
        font-size: 0.85em;
        font-weight: 500;
    }
    .homepage-diff-pill--added {
        background: rgba(46, 204, 113, 0.15);
        color: #27ae60;
        border: 1px solid rgba(46, 204, 113, 0.35);
    }
    .homepage-diff-pill--modified {
        background: rgba(52, 152, 219, 0.15);
        color: #2980b9;
        border: 1px solid rgba(52, 152, 219, 0.35);
    }
    .homepage-diff-pill--removed {
        background: rgba(231, 76, 60, 0.15);
        color: #c0392b;
        border: 1px solid rgba(231, 76, 60, 0.35);
    }
    .homepage-diff-list-wrap {
        max-height: 19em;
        overflow-y: auto;
        border: 1px solid var(--line-color, rgba(120, 120, 120, 0.25));
        border-radius: 0.45em;
        background: rgba(0, 0, 0, 0.1);
    }
    .homepage-diff-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88em;
    }
    .homepage-diff-table th {
        background: rgba(120, 120, 120, 0.12);
        padding: 0.65em 0.85em;
        text-align: left;
        font-weight: 600;
        border-bottom: 1px solid var(--line-color, rgba(120, 120, 120, 0.25));
    }
    .homepage-diff-table td {
        padding: 0.6em 0.85em;
        vertical-align: middle;
        border-bottom: 1px solid var(--line-color, rgba(120, 120, 120, 0.15));
    }
    .homepage-diff-row--added {
        background: rgba(46, 204, 113, 0.07);
    }
    .homepage-diff-row--modified {
        background: rgba(52, 152, 219, 0.07);
    }
    .homepage-diff-row--removed {
        background: rgba(231, 76, 60, 0.07);
    }
    .homepage-diff-badge-status {
        display: inline-block;
        padding: 0.15em 0.5em;
        border-radius: 0.3em;
        font-size: 0.78em;
        font-weight: 600;
        margin-right: 0.4em;
        text-transform: uppercase;
    }
    .homepage-diff-badge-status--added {
        background: #27ae60;
        color: #fff;
    }
    .homepage-diff-badge-status--modified {
        background: #2980b9;
        color: #fff;
    }
    .homepage-diff-badge-status--removed {
        background: #c0392b;
        color: #fff;
    }
    .homepage-diff-code {
        font-family: Consolas, monospace;
        font-size: 0.92em;
        background: rgba(120, 120, 120, 0.15);
        padding: 0.15em 0.4em;
        border-radius: 0.3em;
        word-break: break-all;
    }

    /* --- Template Import Modal Styles --- */
    .homepage-dropzone {
        border: 2px dashed var(--line-color, rgba(120, 120, 120, 0.4));
        border-radius: 0.65em;
        padding: 2.2em 1.5em;
        text-align: center;
        background: rgba(120, 120, 120, 0.05);
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }
    .homepage-dropzone:hover, .homepage-dropzone.dragover {
        border-color: #2980b9;
        background: rgba(41, 128, 185, 0.1);
    }
    .homepage-import-detected-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45em;
        max-height: 8em;
        overflow-y: auto;
        padding: 0.4em 0;
    }
    .homepage-import-detected-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.25em 0.65em;
        border-radius: 0.4em;
        background: rgba(41, 128, 185, 0.15);
        border: 1px solid rgba(41, 128, 185, 0.35);
        font-size: 0.85em;
        font-weight: 500;
    }

    /* --- Unified Focus Ring Styles across All Themes --- */
    .homepage-root input[type="text"]:focus,
    .homepage-root input[type="password"]:focus,
    .homepage-root input[type="number"]:focus,
    .homepage-root select:focus,
    .homepage-root textarea:focus {
        border-color: #e65100 !important;
        box-shadow: 0 0 0 2px rgba(230, 81, 0, 0.22) !important;
        outline: none !important;
    }

    /* --- Mobile & Narrow Viewport Responsive Breakpoints --- */
    @media (max-width: 768px) {
        .homepage-field-row {
            flex-direction: column !important;
            gap: 0.5em !important;
        }
        .homepage-field-label-col {
            width: 100% !important;
        }
        .homepage-field-input-wrap input,
        .homepage-field-input-wrap select {
            min-width: 100% !important;
            max-width: 100% !important;
        }
        .homepage-toolbar {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 0.8em !important;
        }
        .homepage-toolbar-left,
        .homepage-toolbar-right {
            width: 100% !important;
            justify-content: space-between !important;
        }
        #homepage-search {
            width: 100% !important;
        }
        #homepage-search:focus {
            width: 100% !important;
        }
        .homepage-search-wrap {
            flex-grow: 1 !important;
        }
        .homepage-custom-row {
