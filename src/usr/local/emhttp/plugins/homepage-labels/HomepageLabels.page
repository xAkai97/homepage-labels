/**
 * Batch recreate selected containers sequentially with live progress dialog.
 */
function homepageBatchRecreate() {
    var containers = homepageGetSelectedContainers();
    if (!containers.length) return;

    if (!confirm('⚠️ Recreate ' + containers.length + ' container(s)?\n\nEach container will be stopped, updated with latest XML template configuration, and restarted sequentially.\n\nThis may take several seconds per container.')) {
        return;
    }

    homepageBatchCancelled = false;
    $('#homepage-batch-modal').fadeIn(150);
    $('#homepage-batch-btn-cancel').show().prop('disabled', false).text('Stop');
    $('#homepage-batch-btn-done').hide();
    $('#homepage-batch-modal-close').hide();
    $('#homepage-batch-log').empty();
    $('#homepage-batch-progress-bar').css('width', '0%');
    $('#homepage-batch-counter').text('0 of ' + containers.length + ' completed');
    $('#homepage-batch-percent').text('0%');
    $('#homepage-batch-status-text').text('Starting sequential container recreation...');

    var total = containers.length;
    var currentIndex = 0;
    var successes = 0;
    var failures = 0;

    function logMessage(cls, msg) {
        var color = (cls === 'success') ? '#27ae60' : ((cls === 'error') ? '#e53935' : '#e0e0e0');
        var time = new Date().toLocaleTimeString();
        var $entry = $('<div>').css({ color: color, 'margin-bottom': '2px' });
        $entry.append($('<span>').css('opacity', 0.5).text('[' + time + '] '), $('<span>').text(msg));
        var $log = $('#homepage-batch-log');
        $log.append($entry);
        $log.scrollTop($log[0].scrollHeight);
    }

    function processNext() {
        if (homepageBatchCancelled) {
            logMessage('error', '⛔ Operation stopped by user.');
            $('#homepage-batch-status-text').text('Operation stopped.');
            finishBatch();
            return;
        }

        if (currentIndex >= total) {
            logMessage('success', '🎉 All containers processed (' + successes + ' succeeded, ' + failures + ' failed).');
            $('#homepage-batch-status-text').text('Recreation complete!');
            finishBatch();
            return;
        }

        var container = containers[currentIndex];
        var pct = Math.round((currentIndex / total) * 100);
        $('#homepage-batch-progress-bar').css('width', pct + '%');
        $('#homepage-batch-counter').text(currentIndex + ' of ' + total + ' completed');
        $('#homepage-batch-percent').text(pct + '%');
        $('#homepage-batch-status-text').empty().append(
            $('<i>').addClass('fa fa-spinner fa-spin'),
            document.createTextNode(' Recreating container '),
            $('<b>').text(container),
            document.createTextNode(' (' + (currentIndex + 1) + ' of ' + total + ')...')
        );

        logMessage('info', 'Recreating ' + container + '...');

        var token = homepageGetCsrfToken();
        var payload = {
            action: 'recreate_single',
            container: container
        };
        if (token) payload.csrf_token = token;

        $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
            if (resp && resp.success) {
                successes++;
                logMessage('success', '✓ ' + container + ' recreated successfully.');
            } else {
                failures++;
                logMessage('error', '✗ ' + container + ' failed: ' + (resp.error || 'Execution error'));
            }
            currentIndex++;
            processNext();
        }, 'json').fail(function() {
            failures++;
            logMessage('error', '✗ ' + container + ' failed: request timeout or network error.');
            currentIndex++;
            processNext();
        });
    }

    function finishBatch() {
        $('#homepage-batch-progress-bar').css('width', '100%');
        $('#homepage-batch-counter').text(total + ' of ' + total + ' completed');
        $('#homepage-batch-percent').text('100%');
        $('#homepage-batch-btn-cancel').hide();
        $('#homepage-batch-btn-done').show();
        $('#homepage-batch-modal-close').show();
    }

    processNext();
}

/**
 * Cancel sequential batch execution.
 */
function homepageCancelBatch() {
    homepageBatchCancelled = true;
    $('#homepage-batch-btn-cancel').prop('disabled', true).text('Stopping...');
}

/**
 * Close batch progress modal.
 */
function homepageCloseBatchModal(reload) {
    $('#homepage-batch-modal').fadeOut(120);
    if (reload) {
        location.reload();
    }
}

/**
 * Test connectivity for health monitor probe or widget endpoint.
 */
function homepageTestConnection(type) {
    var isWidget = (type === 'widget');
    var $urlInput = isWidget ? $('#field-homepage-widget-url') : ($('#field-homepage-siteMonitor').length ? $('#field-homepage-siteMonitor') : $('#field-homepage-ping'));
    var url = $urlInput.val() ? $urlInput.val().trim() : '';

    var $badge = isWidget ? $('#test-status-widget') : $('#test-status-health');
    var $headerBadge = isWidget ? $('#test-status-widget-header') : $('#test-status-health-header');

    if (!url) {
        var msg = '⚠️ Enter URL first';
        $badge.removeClass('homepage-test-status--ok homepage-test-status--loading').addClass('homepage-test-status--error').text(msg).show();
        $headerBadge.removeClass('homepage-test-status--ok homepage-test-status--loading').addClass('homepage-test-status--error').text(msg).show();
        return;
    }

    $badge.removeClass('homepage-test-status--ok homepage-test-status--error').addClass('homepage-test-status--loading').html('<i class="fa fa-spinner fa-spin"></i> Testing...').show();
    $headerBadge.removeClass('homepage-test-status--ok homepage-test-status--error').addClass('homepage-test-status--loading').html('<i class="fa fa-spinner fa-spin"></i> Testing...').show();

    var payload = {
        action: 'test_connection',
        url: url,
        probe_type: type,
        csrf_token: homepageGetCsrfToken()
    };

    if (isWidget) {
        payload.widget_type = $('#field-homepage-widget-type').val() || '';
        payload.key = $('#field-homepage-widget-key').val() || '';
        payload.username = $('#field-homepage-widget-username').val() || '';
        payload.password = $('#field-homepage-widget-password').val() || '';
    } else {
        payload.method = $('#field-homepage-siteMonitor-method').val() || 'GET';
    }

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp && resp.success) {
            var okText = '✔ ' + (resp.message || 'OK');
            $badge.removeClass('homepage-test-status--loading homepage-test-status--error').addClass('homepage-test-status--ok').text(okText).show();
            $headerBadge.removeClass('homepage-test-status--loading homepage-test-status--error').addClass('homepage-test-status--ok').text(okText).show();
        } else {
            var errText = '✖ ' + ((resp && resp.message) ? resp.message : (resp && resp.error ? resp.error : 'Connection failed'));
            $badge.removeClass('homepage-test-status--loading homepage-test-status--ok').addClass('homepage-test-status--error').text(errText).show();
            $headerBadge.removeClass('homepage-test-status--loading homepage-test-status--ok').addClass('homepage-test-status--error').text(errText).show();
        }
    }, 'json').fail(function() {
        var failText = '✖ Request timed out or server error';
        $badge.removeClass('homepage-test-status--loading homepage-test-status--ok').addClass('homepage-test-status--error').text(failText).show();
        $headerBadge.removeClass('homepage-test-status--loading homepage-test-status--ok').addClass('homepage-test-status--error').text(failText).show();
    });
}

/**
 * Open Bulk Group Assignment Modal
 */
function homepageOpenBulkGroupModal() {
    var containers = homepageGetSelectedContainers();
    if (!containers.length) {
        homepageShowNotification('error', 'Please select at least one container.');
        return;
    }
    $('#homepage-bulk-group-count').text(containers.length);
    var $list = $('#homepage-bulk-group-list').empty();
    containers.forEach(function(c) {
        $list.append($('<span>').addClass('homepage-import-pill').text(c));
    });
    $('#homepage-bulk-group-input').val('');
    $('#homepage-bulk-group-select').val('');
    $('#homepage-bulk-group-modal').fadeIn(150);
}

/**
 * Close Bulk Group Assignment Modal
 */
function homepageCloseBulkGroupModal() {
    $('#homepage-bulk-group-modal').fadeOut(120);
}

/**
 * Submit Bulk Group Assignment
 */
function homepageSubmitBulkGroup() {
    var containers = homepageGetSelectedContainers();
    if (!containers.length) return;
    var group = $('#homepage-bulk-group-input').val().trim();

    var payload = {
        action: 'batch_set_group',
        containers: containers,
        group: group,
        csrf_token: homepageGetCsrfToken()
    };

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
