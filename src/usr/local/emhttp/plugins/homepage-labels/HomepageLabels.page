/**
 * Apply combined multi-select checkboxes + search query and sync group headers.
 */
function homepageApplyFilters() {
    var query = ($('#homepage-search').val() || '').toLowerCase().trim();
    var visibleActive = 0;
    var visibleInactive = 0;

    var selectedStatuses = [];
    var selectedFeatures = [];
    var selectedGroups = [];

    $('.homepage-filter-cb:checked').each(function() {
        var type = $(this).data('filter-type');
        var val = $(this).val();
        if (type === 'status') selectedStatuses.push(val);
        else if (type === 'feature') selectedFeatures.push(val);
        else if (type === 'group') selectedGroups.push(val);
    });

    $('.homepage-row').each(function() {
        var $row = $(this);
        var isActive = $row.data('active') == 1;
        var hasWidget = $row.data('widget') == 1;
        var hasHealth = $row.data('health') == 1;
        var rowGroup = ($row.data('group-name') || '').toString().toLowerCase();
        var searchData = ($row.data('search') || '').toString();

        // 1. Status check (active / inactive)
        var statusMatch = true;
        if (selectedStatuses.length > 0) {
            var rowStatus = isActive ? 'active' : 'inactive';
            if (selectedStatuses.indexOf(rowStatus) === -1) {
                statusMatch = false;
            }
        }

        // 2. Features check (widget / no_widget / health)
        var featureMatch = true;
        if (selectedFeatures.length > 0) {
            for (var i = 0; i < selectedFeatures.length; i++) {
                var feat = selectedFeatures[i];
                if (feat === 'widget' && !hasWidget) { featureMatch = false; break; }
                if (feat === 'no_widget' && hasWidget) { featureMatch = false; break; }
                if (feat === 'health' && !hasHealth) { featureMatch = false; break; }
            }
        }

        // 3. Group check (media / downloads / etc.)
        var groupMatch = true;
        if (selectedGroups.length > 0) {
            if (selectedGroups.indexOf(rowGroup) === -1) {
                groupMatch = false;
            }
        }

        // 4. Search query check
        var searchMatch = true;
        if (query && searchData.indexOf(query) === -1) {
            searchMatch = false;
        }

        if (statusMatch && featureMatch && groupMatch && searchMatch) {
            $row.show();
            if (isActive) visibleActive++;
            else visibleInactive++;
        } else {
            $row.hide();
        }
    });

    var $activeHeader = $('.homepage-group-header-row--active');
    var $inactiveHeader = $('.homepage-group-header-row--inactive');

    if (currentSortMode !== 'active_first') {
        $activeHeader.hide();
        $inactiveHeader.hide();
    } else {
        $activeHeader.toggle(visibleActive > 0);
        $inactiveHeader.toggle(visibleInactive > 0);
    }

    // Dynamic Zero-Results Empty State Row
    var $noMatches = $('#homepage-no-matches-row');
    if (visibleActive === 0 && visibleInactive === 0 && $('.homepage-row').length > 0) {
        if (!$noMatches.length) {
            var emptyHtml = '<tr id="homepage-no-matches-row" class="homepage-no-matches-row">' +
                '<td colspan="8" class="homepage-no-matches-cell">' +
                '<i class="fa fa-filter" style="font-size:2em;opacity:0.35;display:block;margin-bottom:8px;"></i>' +
                '<strong>No containers match your search or filter criteria.</strong><br>' +
                '<button type="button" class="homepage-btn-clear-filters" onclick="homepageClearAllSearchAndFilters()"><i class="fa fa-times"></i> Clear Search &amp; Filters</button>' +
                '</td></tr>';
            $('#homepage-labels-dashboard tbody').append(emptyHtml);
        } else {
            $noMatches.show();
        }
    } else if ($noMatches.length) {
        $noMatches.hide();
    }

    // Re-synchronize master checkbox and bulk toolbar with currently visible selection
    if (typeof homepageOnRowSelect === 'function') {
        homepageOnRowSelect();
    }
}

/* =========================================================================
   INTERACTIVE COLUMN RESIZING & AUTO-FIT ENGINE
   ========================================================================= */

var HOMEPAGE_COL_STORAGE_KEY = 'homepage_col_widths_v1';

/**
 * Initialize draggable column resizers and double-click auto-fit handlers.
 */
function homepageInitColumnResizing() {
    var $table = $('#homepage-labels-dashboard');
    if (!$table.length) return;

    var $ths = $table.find('thead th[data-col]');

    // 1. Restore saved custom widths from localStorage
    try {
        var savedWidths = JSON.parse(localStorage.getItem(HOMEPAGE_COL_STORAGE_KEY) || '{}');
        $ths.each(function() {
            var col = $(this).data('col');
            if (savedWidths[col] && col !== 'actions') {
                $(this).css('width', savedWidths[col] + 'px');
            }
        });
    } catch(e) {}

    function saveCurrentWidths() {
        var widths = {};
        $ths.each(function() {
            var col = $(this).data('col');
            if (col && col !== 'actions') {
                widths[col] = Math.round($(this).outerWidth());
            }
        });
        try {
            localStorage.setItem(HOMEPAGE_COL_STORAGE_KEY, JSON.stringify(widths));
        } catch(e) {}
    }

    // 2. Drag to resize columns (mouse & touch support)
    function homepageStartColResize(e) {
        e.preventDefault();
        e.stopPropagation();

        var isTouch = (e.type === 'touchstart');
        var pageX = isTouch ? e.originalEvent.touches[0].pageX : e.pageX;
        var $resizer = $(this);
        var $th = $resizer.closest('th');
        var startX = pageX;
        var startWidth = $th.outerWidth();
        var minWidth = parseInt($th.css('min-width')) || 60;

        $resizer.addClass('is-resizing');
        $table.addClass('is-resizing');
        $('body').css('cursor', 'col-resize');

        function onColMove(e) {
            var curX = (e.type === 'touchmove') ? e.originalEvent.touches[0].pageX : e.pageX;
            var diff = curX - startX;
            var newWidth = Math.max(minWidth, startWidth + diff);
            $th.css('width', newWidth + 'px');
        }

        function onColEnd() {
            $(document).off('mousemove.homepageResize touchmove.homepageResize', onColMove);
            $(document).off('mouseup.homepageResize touchend.homepageResize touchcancel.homepageResize', onColEnd);
            $resizer.removeClass('is-resizing');
            $table.removeClass('is-resizing');
            $('body').css('cursor', '');
            saveCurrentWidths();
        }

        $(document).on('mousemove.homepageResize touchmove.homepageResize', onColMove);
        $(document).on('mouseup.homepageResize touchend.homepageResize touchcancel.homepageResize', onColEnd);
    }

    $table.on('mousedown touchstart', '.homepage-col-resizer', homepageStartColResize);

    // 3. Double-click resizer to Auto-Fit column width to content
    $table.on('dblclick', '.homepage-col-resizer', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var $th = $(this).closest('th');
        var colIndex = $th.index();
        var colKey = $th.data('col');

        // Measure widest element in this column
        var maxWidth = 0;
        var $thTitle = $th.find('.homepage-th-title');
        if ($thTitle.length) {
            maxWidth = Math.max(maxWidth, $thTitle[0].scrollWidth + 34);
        }

        $table.find('tbody tr:not(.homepage-group-header-row)').each(function() {
            var $td = $(this).children('td').eq(colIndex);
            if ($td.length && $td.is(':visible')) {
                var cellWidth = $td[0].scrollWidth + 28;
                if (cellWidth > maxWidth) maxWidth = cellWidth;
            }
        });

        if (maxWidth > 0) {
            var minW = parseInt($th.css('min-width')) || 60;
            var finalW = Math.max(minW, maxWidth);
            $th.css('width', finalW + 'px');
            saveCurrentWidths();
            homepageShowNotification('success', 'Auto-fitted "' + ($thTitle.text() || colKey) + '" column to ' + finalW + 'px');
        }
    });

    // Prevent sort triggers when clicking resizers
    $table.on('click', '.homepage-col-resizer', function(e) {
        e.stopPropagation();
    });
}

/**
 * Reset all dashboard table column widths to default.
 */
function homepageResetColumnWidths() {
    try {
        localStorage.removeItem(HOMEPAGE_COL_STORAGE_KEY);
    } catch(e) {}

    var $table = $('#homepage-labels-dashboard');
    if ($table.length) {
        $table.find('thead th[data-col]').each(function() {
            var col = $(this).data('col');
            if (col === 'group') $(this).css('width', '130px');
            else if (col === 'discovery') $(this).css('width', '110px');
            else if (col === 'widget') $(this).css('width', '130px');
            else if (col === 'labels') $(this).css('width', '75px');
            else $(this).css('width', '');
        });
        homepageShowNotification('success', 'Column widths reset to default proportions.');
    }
    $('#homepage-sort-menu').hide();
}

/**
 * Navigate to the container label editor.
 */
function homepageEditContainer(name) {
    location.href = '/Settings/HomepageLabels?edit=' + encodeURIComponent(name);
}

/**
 * Disable Homepage discovery for a container (remove all labels).
 */
function homepageDisableContainer(name) {
    if (!confirm('⚠️ Disable Homepage Discovery?\n\nAre you sure you want to remove all Homepage labels from "' + name + '"?\n\nNote: A backup snapshot will be saved. You can undo or restore it anytime.')) {
        return;
    }

    var token = homepageGetCsrfToken();
    var payload = {
        action: 'disable',
        container: name
    };
    if (token) {
        payload.csrf_token = token;
    }

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp.success) {
            homepageShowNotification('success', 'Homepage labels removed for "' + name + '". <button type="button" class="homepage-btn-undo" onclick="homepageRestoreContainer(\'' + name + '\')"><i class="fa fa-undo"></i> Undo</button>');
            setTimeout(function() { location.reload(); }, 2500);
        } else {
            homepageShowNotification('error', 'Failed: ' + (resp.error || 'Unknown error'));
        }
    }, 'json');
}

/**
 * Restore backed-up Homepage labels for a container.
 */
function homepageRestoreContainer(name) {
    var token = homepageGetCsrfToken();
    var payload = {
        action: 'restore',
        container: name
    };
    if (token) {
        payload.csrf_token = token;
    }

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp.success) {
            homepageShowNotification('success', 'Restored ' + (resp.restored_count || '') + ' Homepage labels for "' + name + '". Reloading...');
            setTimeout(function() { location.reload(); }, 1200);
        } else {
            homepageShowNotification('error', 'Failed to restore: ' + (resp.error || 'Unknown error'));
        }
    }, 'json');
}

/**
 * Recreate a single container immediately from the dashboard to apply pending labels.
 */
function homepageRecreateSingle(name) {
    if (!confirm('Recreate container "' + name + '" now to apply pending labels?\n\nActive connections inside this container will be briefly interrupted.')) {
        return;
    }
    var token = homepageGetCsrfToken();
    var payload = {
        action: 'recreate_single',
        container: name
    };
    if (token) payload.csrf_token = token;

    homepageShowNotification('info', '<i class="fa fa-spinner fa-spin"></i> Recreating container "' + name + '"...');
    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp.success) {
            homepageShowNotification('success', '<i class="fa fa-check-circle"></i> Container "' + name + '" recreated successfully.');
            setTimeout(function() { location.reload(); }, 1500);
        } else {
            homepageShowNotification('error', 'Recreate failed: ' + (resp.error || 'Unknown error'));
        }
    }, 'json').fail(function(xhr) {
        homepageShowNotification('error', 'Request failed: ' + xhr.statusText);
    });
}

/**
 * Cancel editing and return to dashboard (or close overlay modal when embedded).
 */
function homepageCancelEdit() {
    if (homepageFormDirty && !confirm('Discard unsaved changes?')) {
        return;
    }
    homepageFormDirty = false;
    if (isEmbedMode && window.parent && window.parent !== window) {
        window.parent.postMessage({ type: 'homepage_labels_close' }, window.location.origin);
        return;
    }
    location.href = '/Settings/HomepageLabels';
}

