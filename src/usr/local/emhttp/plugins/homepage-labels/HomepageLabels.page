/**
 * Switch import tabs between 'file' and 'paste'.
 */
function homepageSetImportTab(tab) {
    if (tab === 'file') {
        $('#import-tab-file').addClass('homepage-tab--active');
        $('#import-tab-paste').removeClass('homepage-tab--active');
        $('#import-panel-file').show();
        $('#import-panel-paste').hide();
    } else {
        $('#import-tab-paste').addClass('homepage-tab--active');
        $('#import-tab-file').removeClass('homepage-tab--active');
        $('#import-panel-paste').show();
        $('#import-panel-file').hide();
    }
}

/**
 * Initialize drag-and-drop on the dropzone.
 */
function homepageInitDropzone() {
    var $dropzone = $('#homepage-import-dropzone');
    if ($dropzone.data('initialized')) return;
    $dropzone.data('initialized', true);

    $dropzone.on('dragover dragenter', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).addClass('homepage-dropzone--active');
    });

    $dropzone.on('dragleave dragend drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).removeClass('homepage-dropzone--active');
    });

    $dropzone.on('drop', function(e) {
        var files = e.originalEvent.dataTransfer ? e.originalEvent.dataTransfer.files : null;
        if (files && files.length > 0) {
            homepageReadAndPreviewFile(files[0]);
        }
    });
}

/**
 * Handle file selection from standard input.
 */
function homepageOnFileSelected(input) {
    if (input.files && input.files.length > 0) {
        homepageReadAndPreviewFile(input.files[0]);
    }
}

/**
 * Read chosen File object as text and parse/preview.
 */
function homepageReadAndPreviewFile(file) {
    $('#homepage-import-file-name').show().html('<i class="fa fa-file-code-o"></i> Selected: <strong>' + htmlspecialchars(file.name) + '</strong> (' + Math.round(file.size / 1024) + ' KB)');
    var reader = new FileReader();
    reader.onload = function(e) {
        var text = e.target.result;
        homepageParseAndPreviewTemplates(text);
    };
    reader.onerror = function() {
        homepageShowNotification('error', 'Failed to read the selected file.');
    };
    reader.readAsText(file);
}

/**
 * Handle input changes in the Paste JSON textarea.
 */
function homepageOnImportTextChange() {
    var text = $('#homepage-import-textarea').val();
    homepageParseAndPreviewTemplates(text);
}

/**
 * Parse JSON text and render template preview pills.
 */
function homepageParseAndPreviewTemplates(jsonText) {
    var $previewWrap = $('#homepage-import-preview-wrap');
    var $count = $('#homepage-import-detected-count');
    var $list = $('#homepage-import-detected-list');
    var $btn = $('#homepage-btn-submit-import');

    if (!jsonText || !jsonText.trim()) {
        $previewWrap.hide();
        $count.text('0');
        $list.empty();
        $btn.prop('disabled', true);
        window._homepageImportPayload = null;
        return;
    }

    try {
        var data = JSON.parse(jsonText);
        var templates = {};
        if (data.templates && typeof data.templates === 'object') {
            templates = data.templates;
        } else if (data.name && (data.labels || data.fields)) {
            var singleId = data.id || data.name.toLowerCase().replace(/[^a-z0-9_-]/g, '-');
            templates[singleId] = data;
        } else if (typeof data === 'object') {
            for (var k in data) {
                if (data.hasOwnProperty(k) && data[k] && typeof data[k] === 'object' && (data[k].name || data[k].labels)) {
                    templates[k] = data[k];
                }
            }
        }

        var keys = Object.keys(templates);
        if (keys.length === 0) {
            $previewWrap.show();
            $count.text('0 (Invalid template structure)');
            $list.html('<span style="color:#e74c3c;font-size:0.88em;">No valid templates recognized in JSON.</span>');
            $btn.prop('disabled', true);
            window._homepageImportPayload = null;
            return;
        }

        $previewWrap.show();
        $count.text(keys.length);
        $list.empty();

        keys.forEach(function(k) {
            var t = templates[k];
            var name = t.name || k;
            var labelCount = t.labels ? Object.keys(t.labels).length : (t.fields ? Object.keys(t.fields).length : 0);
            var $pill = $('<span class="homepage-pill" style="margin:0.2em;display:inline-block;"></span>');
            $pill.html('<i class="fa fa-tag"></i> <strong>' + htmlspecialchars(name) + '</strong> (' + labelCount + ' labels)');
            $list.append($pill);
        });

        $btn.prop('disabled', false);
        window._homepageImportPayload = jsonText;
    } catch (err) {
        $previewWrap.show();
        $count.text('0 (JSON Syntax Error)');
        $list.html('<span style="color:#e74c3c;font-size:0.88em;">Invalid JSON: ' + htmlspecialchars(err.message) + '</span>');
        $btn.prop('disabled', true);
        window._homepageImportPayload = null;
    }
}

/**
 * Submit templates import to the backend.
 */
function homepageSubmitImportTemplates() {
    if (!window._homepageImportPayload) {
        alert('Please provide valid JSON templates before importing.');
        return;
    }

    var mode = $('input[name="homepage_import_mode"]:checked').val() || 'merge';
    var $btn = $('#homepage-btn-submit-import');
    $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Importing...');

    var payload = {
        action: 'import_templates',
        import_data: window._homepageImportPayload,
        import_mode: mode
    };
    var token = homepageGetCsrfToken();
    if (token) payload.csrf_token = token;

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        $btn.prop('disabled', false).html('<i class="fa fa-upload"></i> Import Templates');
        if (resp.success) {
            homepageShowNotification('success', resp.message || 'Templates imported successfully.');
            homepageCloseImportModal();
            homepageRefreshTemplateLists();
        } else {
            alert('Import Error: ' + (resp.error || 'Failed to import templates.'));
        }
    }, 'json').fail(function(xhr, status, error) {
        $btn.prop('disabled', false).html('<i class="fa fa-upload"></i> Import Templates');
        alert('Network/Server error during template import: ' + error);
    });
}


/**
 * JS-side HTML entity escaping utility.
 */
function htmlspecialchars(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/**
 * Refresh template select dropdowns via AJAX.
 */
function homepageRefreshTemplateLists(selectedCustomId) {
    $.get('/plugins/homepage-labels/scripts/apply_labels.php', { action: 'template_list' }, function(resp) {
        if (resp.success && resp.customs) {
            var $sel = $('#custom-template-select');
            $sel.empty().append('<option value="">-- Custom Templates --</option>');
            $.each(resp.customs, function(i, t) {
                var isSel = (selectedCustomId && t.id === selectedCustomId) ? ' selected' : '';
                $sel.append('<option value="' + htmlspecialchars(t.id) + '"' + isSel + '>⭐ ' + htmlspecialchars(t.name) + '</option>');
            });

            var $unifiedGroup = $('#optgroup-custom-templates');
            if ($unifiedGroup.length) {
                $unifiedGroup.empty();
                $.each(resp.customs, function(i, t) {
                    var isSel = (selectedCustomId && t.id === selectedCustomId) ? ' selected' : '';
                    $unifiedGroup.append('<option value="custom:' + htmlspecialchars(t.id) + '"' + isSel + '>⭐ ' + htmlspecialchars(t.name) + '</option>');
                });
                if (selectedCustomId) {
                    $('#unified-template-select').val('custom:' + selectedCustomId);
                }
            }
        }
    }, 'json');
}

/**
 * Dynamically change UI font scale and persist preference via AJAX.
 */
function homepageChangeFontScale(scale) {
    $('#homepage-root-wrap, .homepage-root')
        .removeClass('homepage-scale-100 homepage-scale-110 homepage-scale-125 homepage-scale-140')
        .addClass('homepage-scale-' + scale);

    // Sync all scale select dropdowns on the page
    $('.homepage-scale-switcher select').val(scale);

    var payload = {
        action: 'save_scale',
        scale: scale
    };
    var token = homepageGetCsrfToken();
    if (token) payload.csrf_token = token;

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp.success) {
            homepageShowNotification('success', 'UI readability scale set to ' + scale + '%.');
        }
    }, 'json');
}

