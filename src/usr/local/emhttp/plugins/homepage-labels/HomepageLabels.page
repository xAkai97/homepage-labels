/**
 * Logical sorting order weight for client-side Live Preview.
 */
function homepageGetLabelSortWeight(target) {
    var core = {
        'homepage.group': 10,
        'homepage.name': 11,
        'homepage.icon': 12,
        'homepage.href': 13,
        'homepage.description': 14
    };
    if (core[target]) return core[target];
    if (target === 'homepage.weight') return 20;
    if (target === 'homepage.siteMonitor') return 30;
    if (target === 'homepage.ping') return 31;
    if (target.indexOf('homepage.widget.') === 0) {
        var widget = {
            'homepage.widget.type': 40,
            'homepage.widget.url': 41,
            'homepage.widget.key': 42,
            'homepage.widget.token': 43,
            'homepage.widget.username': 44,
            'homepage.widget.password': 45,
            'homepage.widget.version': 46
        };
        return widget[target] || 50;
    }
    return 100;
}

/**
 * Re-generate live Homepage YAML and Docker labels preview.
 */
function homepageUpdateLivePreview() {
    var group = $('input[name="labels[homepage.group]"]:not(:disabled)').val() || 'My Services';
    var name = $('input[name="labels[homepage.name]"]:not(:disabled)').val() || $('input[name="container"]').val() || 'My Container';
    var icon = $('input[name="labels[homepage.icon]"]:not(:disabled)').val() || '';
    var href = $('input[name="labels[homepage.href]"]:not(:disabled)').val() || '';
    var desc = $('input[name="labels[homepage.description]"]:not(:disabled)').val() || '';
    var weight = $('input[name="labels[homepage.weight]"]:not(:disabled)').val() || '';
    var target = $('select[name="labels[homepage.target]"]:not(:disabled)').val() || '';
    var statusStyle = $('select[name="labels[homepage.statusStyle]"]:not(:disabled)').val() || '';
    var siteMonitor = $('input[name="labels[homepage.siteMonitor]"]:not(:disabled)').val() || '';
    var ping = $('input[name="labels[homepage.ping]"]:not(:disabled)').val() || '';
    var showStats = $('select[name="labels[homepage.showStats]"]:not(:disabled)').val() || '';

    var enableWidget = $('#enable-widget').is(':checked');
    var widgetType = enableWidget ? ($('input[name="labels[homepage.widget.type]"]:not(:disabled)').val() || '') : '';
    var widgetUrl = enableWidget ? ($('input[name="labels[homepage.widget.url]"]:not(:disabled)').val() || '') : '';
    var widgetKey = enableWidget ? ($('input[name="labels[homepage.widget.key]"]:not(:disabled)').val() || '') : '';
    var widgetUser = enableWidget ? ($('input[name="labels[homepage.widget.username]"]:not(:disabled)').val() || '') : '';
    var widgetPass = enableWidget ? ($('input[name="labels[homepage.widget.password]"]:not(:disabled)').val() || '') : '';

    var previewText = '';

    // Synchronize Live Visual Homepage Service Card Mockup
    $('#mockup-group-text').text(group);
    $('#mockup-title-text').text(name);
    if (desc && desc.trim()) {
        $('#mockup-desc-text').text(desc).show();
    } else {
        $('#mockup-desc-text').hide();
    }

    if (siteMonitor || ping) {
        $('#mockup-status-dot').show();
    } else {
        $('#mockup-status-dot').hide();
    }

    if (enableWidget && widgetType) {
        $('#mockup-widget-type-text').html('<i class="fa fa-puzzle-piece"></i> ' + htmlspecialchars(widgetType));
        $('#mockup-widget-wrap').show();
    } else {
        $('#mockup-widget-wrap').hide();
    }

    if (icon && icon.trim()) {
        var resolvedIconUrl = '';
        var cleanIcon = icon.trim();
        if (cleanIcon.indexOf('http://') === 0 || cleanIcon.indexOf('https://') === 0 || cleanIcon.indexOf('/') === 0) {
            resolvedIconUrl = cleanIcon;
        } else if (cleanIcon.indexOf('si-') === 0) {
            resolvedIconUrl = 'https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/' + cleanIcon.replace(/^si-/, '') + '.svg';
        } else if (cleanIcon.indexOf('sh-') === 0) {
            resolvedIconUrl = 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/' + cleanIcon.replace(/^sh-/, '') + '.svg';
        } else if (cleanIcon.indexOf('mdi-') === 0) {
            resolvedIconUrl = 'https://cdn.jsdelivr.net/npm/@mdi/svg@latest/svg/' + cleanIcon.replace(/^mdi-/, '') + '.svg';
        } else if (cleanIcon.indexOf('.') !== -1) {
            var ext = cleanIcon.split('.').pop().toLowerCase();
            var folder = (ext === 'png') ? 'png' : 'svg';
            resolvedIconUrl = 'https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/' + folder + '/' + cleanIcon;
        } else {
            resolvedIconUrl = 'https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/svg/' + cleanIcon + '.svg';
        }
        $('#mockup-icon-img').attr('src', resolvedIconUrl).show();
        $('#mockup-icon-fallback').hide();
    } else {
        $('#mockup-icon-img').hide();
        $('#mockup-icon-fallback').show();
    }

    if (homepageCurrentPreviewTab === 'translated') {
        var yaml = '# Homepage services.yaml Translation:\n';
        yaml += '- ' + group + ':\n';
        yaml += '    - ' + name + ':\n';
        if (icon) yaml += '        icon: ' + icon + '\n';
        if (href) yaml += '        href: ' + href + '\n';
        if (desc) yaml += '        description: ' + desc + '\n';
        if (weight) yaml += '        weight: ' + weight + '\n';
        if (target && target !== '_blank') yaml += '        target: ' + target + '\n';
        if (statusStyle && statusStyle !== 'dot') yaml += '        statusStyle: ' + statusStyle + '\n';
        if (siteMonitor) yaml += '        siteMonitor: ' + siteMonitor + '\n';
        if (ping) yaml += '        ping: ' + ping + '\n';
        if (showStats && showStats === 'true') yaml += '        showStats: true\n';

        if (enableWidget && widgetType) {
            yaml += '        widget:\n';
            yaml += '          type: ' + widgetType + '\n';
            if (widgetUrl) yaml += '          url: ' + widgetUrl + '\n';
            if (widgetKey) yaml += '          key: ' + (widgetKey.length > 4 ? widgetKey.substring(0, 3) + '••••••••' : '••••••••') + '\n';
            if (widgetUser) yaml += '          username: ' + widgetUser + '\n';
            if (widgetPass) yaml += '          password: ••••••••\n';

            // Additional active widget fields
            $('#widget-fields-container .homepage-field-row.homepage-field--active').each(function() {
                var targetKey = $(this).data('target');
                if (['homepage.widget.type', 'homepage.widget.url', 'homepage.widget.key', 'homepage.widget.username', 'homepage.widget.password'].indexOf(targetKey) === -1) {
                    var fieldShortKey = targetKey.replace(/^homepage\.widget\./, '');
                    var fieldVal = $(this).find('input, select').val();
                    if (fieldVal) {
                        var isMasked = $(this).find('input[type="checkbox"][name^="masks"]').is(':checked');
                        yaml += '          ' + fieldShortKey + ': ' + (isMasked ? '••••••••' : fieldVal) + '\n';
                    }
                }
            });
        }

        // Custom labels
        $('.homepage-custom-row').each(function() {
            var cKey = $(this).find('.custom-key').val();
            var cVal = $(this).find('.custom-val').val();
            if (cKey && cVal) {
                yaml += '        # ' + cKey + ': ' + cVal + '\n';
            }
        });
        previewText = yaml;

    } else if (homepageCurrentPreviewTab === 'compose') {
        var compose = '# Docker Compose YAML (labels: block):\n';
        compose += 'services:\n';
        compose += '  ' + (name.toLowerCase().replace(/[^a-z0-9_-]/g, '-') || 'app') + ':\n';
        compose += '    labels:\n';

        $('#homepage-editor-form').find('input[name^="labels["]:not(:disabled), select[name^="labels["]:not(:disabled)').each(function() {
            var match = $(this).attr('name').match(/labels\[([^\]]+)\]/);
            if (match && $(this).val()) {
                compose += '      - ' + match[1] + '=' + $(this).val() + '\n';
            }
        });
        $('.homepage-custom-row').each(function() {
            var cKey = $(this).find('.custom-key').val();
            var cVal = $(this).find('.custom-val').val();
            if (cKey && cVal) {
                compose += '      - ' + cKey + '=' + cVal + '\n';
            }
        });
        previewText = compose;

    } else if (homepageCurrentPreviewTab === 'cli') {
        var cli = '# Docker Run / CLI Flags:\n';
        $('#homepage-editor-form').find('input[name^="labels["]:not(:disabled), select[name^="labels["]:not(:disabled)').each(function() {
            var match = $(this).attr('name').match(/labels\[([^\]]+)\]/);
            if (match && $(this).val()) {
                cli += '  --label ' + match[1] + '="' + $(this).val() + '" \\\n';
            }
        });
        $('.homepage-custom-row').each(function() {
            var cKey = $(this).find('.custom-key').val();
            var cVal = $(this).find('.custom-val').val();
            if (cKey && cVal) {
                cli += '  --label ' + cKey + '="' + cVal + '" \\\n';
            }
        });
        cli = cli.replace(/ \\\n$/, '\n');
        previewText = cli;

    } else if (homepageCurrentPreviewTab === 'xml') {
        var xml = '<!-- Unraid Container Template XML (<Config> nodes): -->\n';
        var xmlConfigs = [];

        $('#homepage-editor-form').find('input[name^="labels["]:not(:disabled), select[name^="labels["]:not(:disabled)').each(function() {
            var match = $(this).attr('name').match(/labels\[([^\]]+)\]/);
            if (match && $(this).val()) {
                var target = match[1];
                var val = $(this).val();
                var $row = $(this).closest('.homepage-field-row');
                var humanName = $row.find('.homepage-field-label-col label').clone().children().remove().end().text().trim() || target;
                var isMasked = $row.find('input[type="checkbox"][name^="masks"]').is(':checked') ? 'true' : 'false';

                var $drawer = $row.find('.homepage-field-config-drawer');
                var cfgName = ($drawer.find('.cfg-attr-name').val() || '').trim() || humanName;
                var cfgDefault = $drawer.find('.cfg-attr-default').val() || '';
                var cfgDesc = ($drawer.find('.cfg-attr-description').val() || '').trim() || 'Homepage Discovery Label';
                var cfgDisplay = $drawer.find('.cfg-attr-display').val() || 'always';
                var cfgRequired = $drawer.find('.cfg-attr-required').val() || 'false';
                var cfgMask = $drawer.find('.cfg-attr-mask').length ? $drawer.find('.cfg-attr-mask').val() : isMasked;

                xmlConfigs.push({
                    target: target,
                    name: cfgName,
                    val: val,
                    default: cfgDefault,
                    desc: cfgDesc,
                    display: cfgDisplay,
                    required: cfgRequired,
                    mask: cfgMask
                });
            }
        });

        $('.homepage-custom-row').each(function() {
            var cKey = $(this).find('.custom-key').val();
            var cVal = $(this).find('.custom-val').val();
            var isMasked = $(this).find('.custom-mask').is(':checked') ? 'true' : 'false';
            if (cKey && cVal) {
                var humanName = cKey.replace(/^homepage\./, '').replace(/\./g, ' ').replace(/\b\w/g, function(l) { return l.toUpperCase(); });
                var $cDrawer = $(this).find('.homepage-custom-config-drawer');
                var cfgName = ($cDrawer.find('.custom-cfg-name').val() || '').trim() || humanName;
                var cfgDefault = $cDrawer.find('.custom-cfg-default').val() || '';
                var cfgDesc = ($cDrawer.find('.custom-cfg-desc').val() || '').trim() || 'Homepage Discovery Label';
                var cfgDisplay = $cDrawer.find('.custom-cfg-display').val() || 'always';
                var cfgRequired = $cDrawer.find('.custom-cfg-required').val() || 'false';
                var cfgMask = $cDrawer.find('.custom-cfg-mask').length ? $cDrawer.find('.custom-cfg-mask').val() : isMasked;

                xmlConfigs.push({
                    target: cKey,
                    name: cfgName,
                    val: cVal,
                    default: cfgDefault,
                    desc: cfgDesc,
                    display: cfgDisplay,
                    required: cfgRequired,
                    mask: cfgMask
                });
            }
        });

        // Sort configs in logical bottom-block order
        xmlConfigs.sort(function(a, b) {
            var wA = homepageGetLabelSortWeight(a.target);
            var wB = homepageGetLabelSortWeight(b.target);
            if (wA !== wB) return wA - wB;
            return a.target.localeCompare(b.target);
        });

        $.each(xmlConfigs, function(i, cfg) {
            xml += '  <Config Name="' + htmlspecialchars(cfg.name) + '" Target="' + htmlspecialchars(cfg.target) + '" Default="' + htmlspecialchars(cfg.default) + '" Mode="" Description="' + htmlspecialchars(cfg.desc) + '" Type="Label" Display="' + htmlspecialchars(cfg.display) + '" Required="' + htmlspecialchars(cfg.required) + '" Mask="' + cfg.mask + '">' + htmlspecialchars(cfg.val) + '</Config>\n';
        });

        previewText = xml;
    }

    $('#homepage-live-yaml').text(previewText);
}

/**
 * Copy active preview content to system clipboard.
 */
function homepageCopyCurrentPreview() {
    var text = $('#homepage-live-yaml').text();
    var label = 'Preview';
    if (homepageCurrentPreviewTab === 'translated') label = 'services.yaml';
    else if (homepageCurrentPreviewTab === 'compose') label = 'Compose YAML';
    else if (homepageCurrentPreviewTab === 'cli') label = 'Docker CLI Flags';
    else if (homepageCurrentPreviewTab === 'xml') label = 'Unraid XML Template';

    if (!text || !text.trim()) {
        homepageShowNotification('error', 'No active preview content to copy.');
        return;
    }

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function() {
            homepageShowNotification('success', label + ' copied to clipboard!');
        }).catch(function() {
            homepageFallbackCopy(text, label);
        });
    } else {
        homepageFallbackCopy(text, label);
    }
}

/**
 * Fallback copy method using temporary textarea.
 */
function homepageFallbackCopy(text, label) {
    var $temp = $('<textarea>');
    $('body').append($temp);
    $temp.val(text).select();
    try {
        document.execCommand('copy');
        homepageShowNotification('success', label + ' copied to clipboard!');
    } catch (e) {
        homepageShowNotification('error', 'Could not copy to clipboard. Please copy manually.');
    }
    $temp.remove();
}

/**
 * Copy YAML or Docker labels to system clipboard (legacy support).
 */
function homepageCopyPreview(format) {
    if (format === 'labels') {
        homepageSwitchPreviewTab('cli');
    } else {
        homepageSwitchPreviewTab('translated');
    }
    homepageCopyCurrentPreview();
}

/* =========================================================================
   FORM VALIDATION & SAVE
   ========================================================================= */

/**
 * Validate required fields before save.
 */
function homepageValidateForm(isApply) {
    var errors = [];
    $('.homepage-field-row').removeClass('homepage-field--error');

    // 1. Group is required
    var $groupInput = $('#homepage-group-input');
    if (!$groupInput.val() || !$groupInput.val().trim()) {
        errors.push('Homepage Group is required.');
        $('#row-field-homepage-group').addClass('homepage-field--error');
        homepageForceExpandSection('core');
    }

    // 2. Name is required
    var $nameInput = $('input[name="labels[homepage.name]"]');
    if (!$nameInput.val() || !$nameInput.val().trim()) {
        errors.push('Display Name is required.');
        $('#row-field-homepage-name').addClass('homepage-field--error');
        homepageForceExpandSection('core');
    }

    // 3. If widget is enabled, check widget required fields
    var isWidgetEnabled = $('#enable-widget').is(':checked');
    if (isWidgetEnabled) {
        var $wTypeInput = $('input[name="labels[homepage.widget.type]"]');
        if (!$wTypeInput.val() || !$wTypeInput.val().trim()) {
            errors.push('Widget Type is required when Widget is enabled.');
            $('#row-field-homepage-widget-type').addClass('homepage-field--error');
            homepageForceExpandSection('widget');
        }

        var $wUrlInput = $('input[name="labels[homepage.widget.url]"]');
        if (!$wUrlInput.val() || !$wUrlInput.val().trim()) {
            errors.push('Widget API URL is required when Widget is enabled.');
            $('#row-field-homepage-widget-url').addClass('homepage-field--error');
            homepageForceExpandSection('widget');
        }

        // Check required fields marked with data-required="1"
        $('#widget-recommended-fields .homepage-field-row[data-required="1"]').each(function() {
            var $input = $(this).find('input[type="text"], input[type="password"], input[type="number"], select');
            if (!$input.val() || !$input.val().trim()) {
                var fieldLabel = $(this).find('label').text().replace('*', '').trim();
                errors.push('Widget field "' + fieldLabel + '" is required.');
                $(this).addClass('homepage-field--error');
                homepageForceExpandSection('widget');
            }
        });
    }

    if (errors.length > 0) {
        homepageShowNotification('error', errors.join('<br>'));
        return false;
    }

    return true;
}

/**
 * Save labels with Pre-Save Diff inspection when recreate is requested.
 */
function homepageSaveLabels(recreate) {
    if (!homepageValidateForm(recreate)) {
        return;
    }

    // Direct save without modal if not recreating container
    if (!recreate) {
        homepageExecuteSaveLabels(false);
        return;
    }

    var containerName = $('#homepage-container-name').val() || $('input[name="container"]').val() || '';

    // Check if user previously opted to skip recreate warning for this container this session
    var skipSession = sessionStorage.getItem('homepage_skip_recreate_warning_' + containerName);
    if (skipSession === '1') {
        homepageExecuteSaveLabels(true);
        return;
    }

    // Build form data for diff inspection
    var $form = $('#homepage-editor-form');
    var data = $form.serialize();
    data += '&action=get_save_diff';
    var token = homepageGetCsrfToken();
    if (token && data.indexOf('csrf_token=') === -1) {
        data += '&csrf_token=' + encodeURIComponent(token);
    }

    // Collect custom rows identically
    $('.homepage-custom-row').each(function() {
        var key = $(this).find('.custom-key').val();
        var val = $(this).find('.custom-val').val();
        var masked = $(this).find('.custom-mask').is(':checked');
        if (key && key.indexOf('homepage.') === 0 && val) {
            data += '&labels[' + encodeURIComponent(key) + ']=' + encodeURIComponent(val);
            if (masked) {
                data += '&masks[' + encodeURIComponent(key) + ']=true';
            }
            var $cDrawer = $(this).find('.homepage-custom-config-drawer');
            if ($cDrawer.length) {
                var cName = $cDrawer.find('.custom-cfg-name').val();
                var cDef = $cDrawer.find('.custom-cfg-default').val();
                var cDesc = $cDrawer.find('.custom-cfg-desc').val();
                var cDisp = $cDrawer.find('.custom-cfg-display').val();
                var cReq = $cDrawer.find('.custom-cfg-required').val();
                var cMask = $cDrawer.find('.custom-cfg-mask').length ? $cDrawer.find('.custom-cfg-mask').val() : (masked ? 'true' : 'false');

                if (cName) data += '&configs[' + encodeURIComponent(key) + '][name]=' + encodeURIComponent(cName);
                if (cDef) data += '&configs[' + encodeURIComponent(key) + '][default]=' + encodeURIComponent(cDef);
                if (cDesc) data += '&configs[' + encodeURIComponent(key) + '][description]=' + encodeURIComponent(cDesc);
                if (cDisp) data += '&configs[' + encodeURIComponent(key) + '][display]=' + encodeURIComponent(cDisp);
                if (cReq) data += '&configs[' + encodeURIComponent(key) + '][required]=' + encodeURIComponent(cReq);
                data += '&configs[' + encodeURIComponent(key) + '][mask]=' + encodeURIComponent(cMask);
            }
        }
    });

    var $btnApply = $('#btn-save-apply');
    var origVal = $btnApply.val();
    $btnApply.val('Checking diff...').prop('disabled', true);

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', data, function(resp) {
        $btnApply.val(origVal).prop('disabled', false);

        if (!resp || !resp.success) {
            // Fallback directly to save if diff check fails
            homepageExecuteSaveLabels(true);
            return;
        }

        if (resp.changed === false) {
            homepageShowNotification('info', 'No label changes detected. Container recreation skipped.');
            return;
        }

        homepageOpenDiffModal(resp);
    }, 'json').fail(function() {
        $btnApply.val(origVal).prop('disabled', false);
        homepageExecuteSaveLabels(true);
    });
}

/**
 * Open the Pre-Save Diff & Recreate Warning modal.
 */
function homepageOpenDiffModal(diffData) {
    $('#homepage-diff-container-title').text(diffData.container);
    $('#homepage-diff-container-highlight').text(diffData.container);

    $('#diff-badge-added').text(diffData.added);
    $('#diff-badge-modified').text(diffData.modified);
    $('#diff-badge-removed').text(diffData.removed);

    $('#diff-pill-added').toggle(diffData.added > 0);
    $('#diff-pill-modified').toggle(diffData.modified > 0);
    $('#diff-pill-removed').toggle(diffData.removed > 0);

    var $tbody = $('#homepage-diff-table-body');
    $tbody.empty();

    if (!diffData.diffs || diffData.diffs.length === 0) {
        $tbody.append('<tr><td colspan="3" style="text-align:center;padding:1.5em;opacity:0.7;">No changes detected.</td></tr>');
    } else {
        $.each(diffData.diffs, function(i, d) {
            var rowClass = 'homepage-diff-row--' + d.status;
            var badgeClass = 'homepage-diff-badge-status--' + d.status;
            var badgeLabel = d.status === 'added' ? '+ Added' : (d.status === 'modified' ? '~ Modified' : '- Removed');

            var oldHtml = d.old_val ? '<code class="homepage-diff-code">' + htmlspecialchars(d.old_val) + '</code>' : '<em style="opacity:0.5;">(none)</em>';
            var newHtml = d.new_val ? '<code class="homepage-diff-code">' + htmlspecialchars(d.new_val) + '</code>' : '<em style="opacity:0.5;">(removed)</em>';

            var tr = '<tr class="' + rowClass + '">' +
                '<td><span class="homepage-diff-badge-status ' + badgeClass + '">' + badgeLabel + '</span> ' +
                '<strong>' + htmlspecialchars(d.name) + '</strong><br><small style="opacity:0.65;">' + htmlspecialchars(d.target) + '</small></td>' +
                '<td>' + oldHtml + '</td>' +
                '<td>' + newHtml + '</td>' +
                '</tr>';
            $tbody.append(tr);
        });
    }

    $('#homepage-diff-skip-session').prop('checked', false);
    $('#homepage-diff-modal').off('click').on('click', function(e) {
        if ($(e.target).is('#homepage-diff-modal')) {
            homepageCloseDiffModal();
        }
    });
    $('body').css('overflow', 'hidden');
    $('#homepage-diff-modal').fadeIn(150);
}

/**
 * Close the Pre-Save Diff modal.
 */
function homepageCloseDiffModal() {
    $('#homepage-diff-modal').fadeOut(120);
    $('body').css('overflow', '');
}

/**
 * Confirm save and proceed with container recreation.
 */
function homepageConfirmSaveAndRecreate() {
    var containerName = $('#homepage-diff-container-title').text();
    if ($('#homepage-diff-skip-session').is(':checked') && containerName) {
        sessionStorage.setItem('homepage_skip_recreate_warning_' + containerName, '1');
    }
    homepageCloseDiffModal();
    homepageExecuteSaveLabels(true);
}

/**
 * Switch from recreation to saving XML only.
 */
function homepageConfirmSaveXmlOnly() {
    homepageCloseDiffModal();
    homepageExecuteSaveLabels(false);
}

/**
 * Collect all currently active Homepage labels from the editor form for parent overlay sync.
 */
function homepageCollectActiveLabelsMap() {
    var result = {};
    var isWidgetEnabled = $('#enable-widget').is(':checked');

    $('.homepage-field-row.homepage-field--active').each(function() {
        var $row = $(this);
        var section = $row.data('section') || '';
        if (section === 'widget' && !isWidgetEnabled) {
            return;
        }
        var target = $row.data('target') || '';
        if (!target || target.indexOf('homepage.') !== 0) return;

        var $input = $row.find('input[name^="labels["], select[name^="labels["]').first();
        if (!$input.length || $input.prop('disabled')) return;
        var val = ($input.val() || '').toString().trim();
        if (!val) return;

        var isMasked = $row.find('input[type="checkbox"][name^="masks["]').is(':checked');
        var $drawer = $row.find('.homepage-field-config-drawer');
        result[target] = {
            value: val,
            mask: isMasked ? 'true' : 'false',
            name: ($drawer.find('.cfg-attr-name').val() || target),
            description: ($drawer.find('.cfg-attr-description').val() || 'Homepage Discovery Label'),
            display: ($drawer.find('.cfg-attr-display').val() || 'always'),
            required: ($drawer.find('.cfg-attr-required').val() || 'false')
        };
    });

    $('.homepage-custom-row').each(function() {
        var key = ($(this).find('.custom-key').val() || '').trim();
        var val = ($(this).find('.custom-val').val() || '').trim();
        var masked = $(this).find('.custom-mask').is(':checked');
        if (key && key.indexOf('homepage.') === 0 && val) {
            var $cDrawer = $(this).find('.homepage-custom-config-drawer');
            result[key] = {
                value: val,
                mask: masked ? 'true' : 'false',
                name: ($cDrawer.find('.custom-cfg-name').val() || key),
                description: ($cDrawer.find('.custom-cfg-desc').val() || 'Homepage Discovery Label'),
                display: ($cDrawer.find('.custom-cfg-display').val() || 'always'),
                required: ($cDrawer.find('.custom-cfg-required').val() || 'false')
            };
        }
    });

    return result;
}

/**
 * Execute actual label persistence to XML and optional Docker container recreation.
 */
function homepageExecuteSaveLabels(recreate) {
    var $form = $('#homepage-editor-form');
    var data = $form.serialize();
    data += '&action=save';
    data += '&recreate=' + (recreate ? '1' : '0');
    var token = homepageGetCsrfToken();
    if (token && data.indexOf('csrf_token=') === -1) {
        data += '&csrf_token=' + encodeURIComponent(token);
    }

    // Collect custom rows
    $('.homepage-custom-row').each(function() {
        var key = $(this).find('.custom-key').val();
        var val = $(this).find('.custom-val').val();
        var masked = $(this).find('.custom-mask').is(':checked');
        if (key && key.indexOf('homepage.') === 0 && val) {
            data += '&labels[' + encodeURIComponent(key) + ']=' + encodeURIComponent(val);
            if (masked) {
                data += '&masks[' + encodeURIComponent(key) + ']=true';
            }
            var $cDrawer = $(this).find('.homepage-custom-config-drawer');
            if ($cDrawer.length) {
                var cName = $cDrawer.find('.custom-cfg-name').val();
                var cDef = $cDrawer.find('.custom-cfg-default').val();
                var cDesc = $cDrawer.find('.custom-cfg-desc').val();
                var cDisp = $cDrawer.find('.custom-cfg-display').val();
                var cReq = $cDrawer.find('.custom-cfg-required').val();

                if (cName) data += '&configs[' + encodeURIComponent(key) + '][name]=' + encodeURIComponent(cName);
                if (cDef) data += '&configs[' + encodeURIComponent(key) + '][default]=' + encodeURIComponent(cDef);
                if (cDesc) data += '&configs[' + encodeURIComponent(key) + '][description]=' + encodeURIComponent(cDesc);
                if (cDisp) data += '&configs[' + encodeURIComponent(key) + '][display]=' + encodeURIComponent(cDisp);
                if (cReq) data += '&configs[' + encodeURIComponent(key) + '][required]=' + encodeURIComponent(cReq);
                var cMask = $cDrawer.find('.custom-cfg-mask').length ? $cDrawer.find('.custom-cfg-mask').val() : (masked ? 'true' : 'false');
                data += '&configs[' + encodeURIComponent(key) + '][mask]=' + encodeURIComponent(cMask);
            }
        }
    });

    $('.homepage-actions-bar input, .homepage-actions button').prop('disabled', true);

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', data, function(resp) {
        $('.homepage-actions-bar input, .homepage-actions button').prop('disabled', false);

        if (resp.success) {
            homepageFormDirty = false;
            var msg = '';

            if (resp.changed === false) {
                msg = 'No label changes detected. Template is already up to date.';
                if (resp.recreate_skipped) {
                    msg += ' Container recreation skipped.';
                }
            } else {
                var details = [];
                if (resp.modified > 0) details.push(resp.modified + ' modified');
                if (resp.added > 0) details.push(resp.added + ' added');
                if (resp.removed > 0) details.push(resp.removed + ' removed');
                msg = 'Labels saved successfully (' + (details.join(', ') || 'updated') + ').';
                if (recreate && resp.recreated) {
                    msg += ' Container is being recreated...';
                }
            }

            if (resp.warning) {
                homepageShowNotification('warning', msg + '<br>' + resp.warning);
            } else {
                homepageShowNotification('success', msg);
            }

            if (isEmbedMode && window.parent && window.parent !== window) {
                window.parent.postMessage({
                    type: 'homepage_labels_saved',
                    container: $('#homepage-container-name').val() || $('input[name="container"]').val() || '',
                    recreated: !!(recreate && resp.recreated),
                    changed: resp.changed !== false,
                    added: resp.added || 0,
                    modified: resp.modified || 0,
                    removed: resp.removed || 0,
                    labels: homepageCollectActiveLabelsMap()
                }, window.location.origin);
                setTimeout(function() {
                    window.parent.postMessage({ type: 'homepage_labels_close' }, window.location.origin);
                }, recreate ? 1400 : 900);
                return;
            }

            if (!recreate) {
                setTimeout(function() { location.href = '/Settings/HomepageLabels'; }, 1800);
            } else {
                setTimeout(function() { location.href = '/Settings/HomepageLabels'; }, 2400);
            }
        } else {
            homepageShowNotification('error', 'Save failed: ' + (resp.error || 'Unknown error'));
        }
    }, 'json').fail(function(xhr) {
        $('.homepage-actions-bar input, .homepage-actions button').prop('disabled', false);
        homepageShowNotification('error', 'Request failed: ' + xhr.statusText);
    });
}

