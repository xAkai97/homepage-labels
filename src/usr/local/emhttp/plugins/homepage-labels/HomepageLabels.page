/**
 * Handle selection change on the unified template select dropdown.
 */
function homepageOnUnifiedTemplateChange(val) {
    if (!val) {
        $('#default-template-select').val('');
        $('#custom-template-select').val('');
        return;
    }
    if (val.indexOf('default:') === 0) {
        var key = val.substring(8);
        $('#default-template-select').val(key);
        $('#custom-template-select').val('');
    } else if (val.indexOf('custom:') === 0) {
        var id = val.substring(7);
        $('#custom-template-select').val(id);
        $('#default-template-select').val('');
    }
}

/**
 * Apply the selected preset or custom template from #unified-template-select.
 */
function homepageApplyUnifiedTemplate() {
    var val = $('#unified-template-select').val();
    if (!val) {
        alert('Please choose a preset or template from the dropdown to apply.');
        return;
    }
    if (val.indexOf('default:') === 0) {
        homepageApplySelectedDefault();
    } else if (val.indexOf('custom:') === 0) {
        homepageApplySelectedCustom();
    }
}

/**
 * Clone the currently selected item in #unified-template-select.
 */
function homepageCloneUnifiedSelected() {
    var val = $('#unified-template-select').val();
    if (!val) {
        alert('Please select a preset or template to clone first.');
        return;
    }
    if (val.indexOf('default:') === 0) {
        homepageCloneSelectedDefault();
    } else if (val.indexOf('custom:') === 0) {
        var id = val.substring(7);
        var customName = $('#unified-template-select option:selected').text().replace('⭐ ', '');
        var newName = prompt('Enter a name for the cloned custom template:', customName + ' (Copy)');
        if (!newName || !newName.trim()) return;
        var payload = {
            action: 'template_clone',
            source_type: 'custom',
            template_id: id,
            new_name: newName.trim(),
            csrf_token: homepageGetCsrfToken()
        };
        $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
            if (resp.success) {
                homepageShowNotification('success', 'Cloned template: ' + newName);
                homepageRefreshTemplateLists(resp.new_template_id);
            } else {
                homepageShowNotification('error', 'Clone failed: ' + (resp.error || 'Unknown error'));
            }
        }, 'json');
    }
