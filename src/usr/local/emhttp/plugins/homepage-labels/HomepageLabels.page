/**
 * Apply selected default preset values directly to active editor form.
 */
function homepageApplySelectedDefault() {
    var presetKey = $('#default-template-select').val();
    if (!presetKey) {
        alert('Please select a default preset to apply.');
        return;
    }

    var currentContainer = $('input[name="container"]').val();
    var payload = {
        action: 'template_apply',
        type: 'default',
        template_id: presetKey,
        container: currentContainer
    };
    var token = homepageGetCsrfToken();
    if (token) payload.csrf_token = token;

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp.success) {
            if (resp.fields) {
                $.each(resp.fields, function(target, fieldData) {
                    var inputId = 'field-' + target.replace(/[^a-zA-Z0-9_\-]/g, '-');
                    var $input = (target === 'homepage.group') ? $('#homepage-group-input') : $('#' + inputId);
                    var $row = $('#row-' + inputId);

                    if ($input.length) {
                        $input.val(fieldData.value || '').prop('disabled', false);
                        $row.removeClass('homepage-field--dimmed').addClass('homepage-field--active');
                        if (target === 'homepage.icon') {
                            homepageUpdateIconPreview(fieldData.value || '');
                        }
                    }

                    if ($row.length) {
                        var $drawer = $row.find('.homepage-field-config-drawer');
                        if ($drawer.length) {
                            if (fieldData.name) $drawer.find('.cfg-attr-name').val(fieldData.name);
                            if (typeof fieldData.default !== 'undefined') $drawer.find('.cfg-attr-default').val(fieldData.default);
                            if (fieldData.description) $drawer.find('.cfg-attr-description').val(fieldData.description);
                            if (fieldData.display) $drawer.find('.cfg-attr-display').val(fieldData.display);
                            if (fieldData.required) $drawer.find('.cfg-attr-required').val(fieldData.required);
                            if (fieldData.mask) {
                                $drawer.find('.cfg-attr-mask').val(fieldData.mask);
                                $row.find('input[type="checkbox"][name^="masks"]').prop('checked', fieldData.mask === 'true');
                            }
                        }
                    }
                });
            }

            if (typeof resp.widget_enabled !== 'undefined') {
                var widgetEnabled = (resp.widget_enabled === true || resp.widget_enabled === 1 || resp.widget_enabled === '1');
                $('#enable-widget').prop('checked', widgetEnabled);
                homepageToggleWidgetSection(widgetEnabled);
            }

            homepageShowNotification('success', 'Preset "' + (resp.name || presetKey) + '" applied to editor. Click "Save XML Only" or "Save & Apply" to write changes.');
            homepageUpdateLivePreview();
            homepageRefreshAllBadges();
            homepageOnFieldChange();
        } else {
            homepageShowNotification('error', 'Failed to apply preset: ' + (resp.error || 'Unknown error'));
        }
    }, 'json');
}

