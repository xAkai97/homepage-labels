        opacity: 0.8;
        user-select: none;
    }
    .homepage-mask-toggle:hover {
        opacity: 1;
    }
    .homepage-mask-toggle input:checked + i {
        color: #e67e22;
    }

    /* --- Custom Group Combobox (Unraid UI Native Style) --- */
    .homepage-combobox-wrap {
        position: relative;
        display: inline-block;
        width: 25em;
        max-width: 100%;
        vertical-align: middle;
    }
    .homepage-combobox-wrap input.homepage-combobox-input {
        width: 100% !important;
        padding: 0.55em 2.4em 0.55em 0.85em !important;
        box-sizing: border-box;
        border-radius: 0.4em !important;
        font-size: 0.98em !important;
    }
    .homepage-combobox-toggle {
        position: absolute;
        right: 0.15em;
        top: 0.15em;
        bottom: 0.15em;
        width: 2.2em;
        background: transparent;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(120, 120, 120, 0.8);
        font-size: 0.85em;
        transition: color 0.15s ease;
        padding: 0;
        outline: none;
    }
    .homepage-combobox-toggle:hover {
        color: #e65100;
    }
    .homepage-combobox-menu {
        display: none;
        position: absolute;
        top: calc(100% + 0.3em);
        left: 0;
        right: 0;
        max-height: 15em;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid rgba(120, 120, 120, 0.35);
        border-radius: 0.55em;
        box-shadow: 0 0.4em 1.2em rgba(0,0,0,0.14);
        z-index: 1050;
        margin: 0;
        padding: 0.4em 0;
    }
    .homepage-combobox-item {
        padding: 0.6em 1.1em;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.7em;
        font-size: 0.96em;
        color: #222222;
        transition: background 0.1s ease, color 0.1s ease;
    }
    .homepage-combobox-item i {
        opacity: 0.65;
        font-size: 0.98em;
    }
    .homepage-combobox-item:hover,
    .homepage-combobox-item.active {
        background: rgba(230, 81, 0, 0.12);
        color: #e65100;
        font-weight: 500;
    }
    .homepage-combobox-item:hover i,
    .homepage-combobox-item.active i {
        opacity: 1;
        color: #e65100;
    }
    .homepage-combobox-empty {
        padding: 0.7em 1.1em;
        font-size: 0.88em;
        opacity: 0.65;
        font-style: italic;
    }

    /* --- Dark & Custom Theme Overrides --- */
    html.black input.custom-key,
    html.black input.custom-val,
    body.dark input.custom-key,
    body.dark input.custom-val,
    html.dark input.custom-key,
    html.dark input.custom-val {
        background: #242424 !important;
        color: #eeeeee !important;
        border-color: #444444 !important;
    }
    html.black .homepage-combobox-menu,
    body.dark .homepage-combobox-menu,
    html.dark .homepage-combobox-menu {
        background: #242424 !important;
        border-color: #444444 !important;
        box-shadow: 0 0.4em 1.2em rgba(0,0,0,0.55) !important;
    }
    html.black .homepage-combobox-item,
    body.dark .homepage-combobox-item,
    html.dark .homepage-combobox-item {
