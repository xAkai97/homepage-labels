/**
 * Update the icon preview next to the icon input.
 */
function homepageUpdateIconPreview(value) {
    var $preview = $('#icon-preview');
    $preview.empty();
    if (!value || !value.trim()) return;
    value = value.trim();

    var img = document.createElement('img');
    img.style.cssText = 'width:24px;height:24px;object-fit:contain;vertical-align:middle;border-radius:4px;background:rgba(128,128,128,0.1);padding:2px;';
    img.alt = 'icon preview';

    if (value.match(/^https?:\/\//)) {
        img.src = value;
    } else if (value.indexOf('/') === 0) {
        // Local custom icon path e.g. /icons/healarr.png or /images/healarr.png
        var filename = value.split('/').pop();
        img.src = '/plugins/homepage-labels/scripts/apply_labels.php?action=get_icon_thumb&name=' + encodeURIComponent(filename);
    } else if (value.indexOf('si-') === 0) {
        img.src = 'https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/' + value.replace(/^si-/, '') + '.svg';
    } else if (value.indexOf('sh-') === 0) {
        img.src = 'https://cdn.jsdelivr.net/gh/selfhst/icons/svg/' + value.replace(/^sh-/, '') + '.svg';
    } else if (value.indexOf('mdi-') === 0) {
        img.src = 'https://cdn.jsdelivr.net/npm/@mdi/svg@latest/svg/' + value.replace(/^mdi-/, '') + '.svg';
    } else if (value.match(/\.png$/i)) {
        img.src = 'https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png/' + value;
    } else if (value.match(/\.svg$/i)) {
        img.src = 'https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/svg/' + value;
    } else {
        img.src = 'https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/svg/' + value + '.svg';
    }

    img.onerror = function() {
        $(this).remove();
        if ($preview.is(':empty')) {
            $preview.append($('<span class="homepage-icon-name" style="font-size:0.85em;opacity:0.8;">').text(value));
        }
    };

    $preview.append(img);
}

/**
 * Show a notification banner with type-specific icon, colors, and auto-dismiss.
 */
var homepageNotifTimer = null;
function homepageShowNotification(type, message) {
    var $notif = $('#homepage-notification');
    clearTimeout(homepageNotifTimer);
    $notif.removeClass('homepage-notification--success homepage-notification--error homepage-notification--info homepage-notification--warning');
    $notif.addClass('homepage-notification--' + type);

    var icon = 'check-circle';
    if (type === 'error' || type === 'warning') icon = 'exclamation-triangle';
    else if (type === 'info') icon = 'info-circle';

    $notif.empty().append($('<i>').addClass('fa fa-' + icon), ' ', $('<span>').text(message));
    $notif.slideDown(200);

    if (type === 'success' || type === 'info' || type === 'warning') {
        homepageNotifTimer = setTimeout(function() { $notif.slideUp(200); }, 5500);
    }
}

/* =========================================================================
   GROUP COMBOBOX DROPDOWN (AUTOCOMPLETE)
   ========================================================================= */

/**
 * Toggle or open the group combobox dropdown.
 */
function homepageToggleCombobox(e) {
    if (e) e.stopPropagation();
    var $menu = $('#homepage-group-menu');
    if ($menu.is(':visible')) {
        $menu.hide();
    } else {
        homepageFilterCombobox();
        $menu.show();
    }
}

/**
 * Filter combobox items based on input value.
 */
function homepageFilterCombobox() {
    var val = ($('#homepage-group-input').val() || '').toLowerCase().trim();
    var $menu = $('#homepage-group-menu');
    var $items = $menu.find('.homepage-combobox-item');
    var visibleCount = 0;

    $items.each(function() {
        var itemVal = ($(this).data('value') || '').toString().toLowerCase();
        if (!val || itemVal.indexOf(val) !== -1) {
            $(this).show();
            visibleCount++;
        } else {
            $(this).hide();
        }
    });

    $menu.find('.homepage-combobox-empty').remove();
    if (visibleCount === 0 && val) {
        var safeInput = $('<div>').text($('#homepage-group-input').val()).html();
        $menu.append('<div class="homepage-combobox-empty">Type to use <strong>"' + safeInput + '"</strong> as new group</div>');
    }
}

/**
 * Select a group from the combobox.
 */
function homepageSelectGroup(val) {
    $('#homepage-group-input').val(val);
    $('#homepage-group-menu').hide();
    $('#homepage-group-input').focus();
    homepageOnFieldChange();
}

// Group Combobox & Quickfill Delegated Event Listeners
$(document).on('click', '.homepage-combobox-item', function(e) {
    e.preventDefault();
    var val = $(this).data('value');
    if (val !== undefined) {
        homepageSelectGroup(val);
    }
});

$(document).on('click', '.homepage-quickfill-chip', function(e) {
    e.preventDefault();
    var inputId = $(this).data('input-id');
    var url = $(this).data('url');
    if (inputId && url !== undefined) {
        homepageQuickFillUrl(inputId, url);
    }
});

$(document).on('click', '.homepage-batch-template-item', function(e) {
    e.preventDefault();
    var tId = $(this).data('template-id');
    var src = $(this).data('source');
    var name = $(this).data('name');
    if (tId) {
        homepageBatchApplyTemplate(tId, src, name);
    }
});

$(document).on('click', function(e) {
    if (!$(e.target).closest('.homepage-combobox-wrap').length) {
        $('#homepage-group-menu').hide();
    }
});

$(document).on('focus', '#homepage-group-input', function() {
    homepageFilterCombobox();
    $('#homepage-group-menu').show();
});

$(document).on('input', '#homepage-group-input', function() {
    homepageFilterCombobox();
    $('#homepage-group-menu').show();
    homepageOnFieldChange();
});

$(document).on('keydown', '#homepage-group-input', function(e) {
    var $menu = $('#homepage-group-menu');
    if (!$menu.is(':visible')) {
        if (e.key === 'ArrowDown') {
            $menu.show();
            homepageFilterCombobox();
            e.preventDefault();
        }
        return;
    }

    var $visibleItems = $menu.find('.homepage-combobox-item:visible');
    var $active = $visibleItems.filter('.active');

    if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!$active.length || $active.is(':last-child')) {
            $visibleItems.removeClass('active');
            $visibleItems.first().addClass('active');
        } else {
            $active.removeClass('active').nextAll('.homepage-combobox-item:visible').first().addClass('active');
        }
    } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (!$active.length || $active.is(':first-child')) {
            $visibleItems.removeClass('active');
            $visibleItems.last().addClass('active');
        } else {
            $active.removeClass('active').prevAll('.homepage-combobox-item:visible').first().addClass('active');
        }
    } else if (e.key === 'Enter') {
        if ($active.length) {
            e.preventDefault();
            homepageSelectGroup($active.data('value'));
        }
    } else if (e.key === 'Escape') {
        $menu.hide();
    }
});

// Global keyboard handler for Esc to close modal
$(document).keydown(function(e) {
    if (e.key === 'Escape' || e.keyCode === 27) {
        if ($('.homepage-dropdown-menu:visible').length) {
            $('.homepage-dropdown-menu').hide();
        } else if ($('#homepage-diff-modal').is(':visible')) {
            homepageCloseDiffModal();
        } else if ($('#homepage-import-modal').is(':visible')) {
            homepageCloseImportModal();
        } else if ($('#homepage-batch-modal').is(':visible') && $('#homepage-batch-modal-close').is(':visible')) {
            homepageCloseBatchModal(false);
        }
    }
});

/* =========================================================================
   DASHBOARD BATCH & BULK OPERATIONS
   ========================================================================= */

var homepageBatchCancelled = false;

/**
 * Toggle select all visible checkboxes.
 */
function homepageToggleSelectAll(masterCb) {
    var checked = $(masterCb).prop('checked');
    $('.homepage-row:visible .homepage-row-select').each(function() {
        $(this).prop('checked', checked);
        var $row = $(this).closest('.homepage-row');
        if (checked) {
            $row.addClass('homepage-row--selected');
        } else {
            $row.removeClass('homepage-row--selected');
        }
    });
    homepageUpdateBulkToolbar();
}

/**
 * Handle individual row selection checkbox change.
 */
function homepageOnRowSelect() {
    var $visibleSelects = $('.homepage-row:visible .homepage-row-select');
    var $checkedSelects = $visibleSelects.filter(':checked');

    // Update row highlighting
    $('.homepage-row').each(function() {
        var isChecked = $(this).find('.homepage-row-select').prop('checked');
        if (isChecked) {
            $(this).addClass('homepage-row--selected');
        } else {
            $(this).removeClass('homepage-row--selected');
        }
    });

    // Update master checkbox state
    var allChecked = ($visibleSelects.length > 0 && $visibleSelects.length === $checkedSelects.length);
    var someChecked = ($checkedSelects.length > 0 && !allChecked);
    $('#homepage-select-all').prop('checked', allChecked).prop('indeterminate', someChecked);

    homepageUpdateBulkToolbar();
}

/**
 * Update visibility and count on the bulk toolbar.
 */
function homepageUpdateBulkToolbar() {
    var count = $('.homepage-row-select:checked').length;
    $('#homepage-bulk-count').text(count);
    if (count > 0) {
        $('#homepage-bulk-toolbar').slideDown(150);
    } else {
        $('#homepage-bulk-toolbar').slideUp(150);
        $('#homepage-select-all').prop('checked', false).prop('indeterminate', false);
    }
}

/**
 * Deselect all containers.
 */
function homepageClearSelection() {
    $('.homepage-row-select').prop('checked', false);
    $('.homepage-row').removeClass('homepage-row--selected');
    $('#homepage-select-all').prop('checked', false).prop('indeterminate', false);
    homepageUpdateBulkToolbar();
}

/**
 * Get list of selected container names.
 */
function homepageGetSelectedContainers() {
    var selected = [];
    $('.homepage-row-select:checked').each(function() {
        var name = $(this).data('container');
        if (name) selected.push(name);
    });
    return selected;
}

/**
 * Batch enable discovery for selected containers.
 */
function homepageBatchEnable() {
    var containers = homepageGetSelectedContainers();
    if (!containers.length) return;

    if (!confirm('Enable Homepage Discovery for ' + containers.length + ' container(s)?\n\nDefault labels (group, name, icon, href) will be generated and saved for each container.')) {
        return;
    }

    var token = homepageGetCsrfToken();
    var payload = {
        action: 'batch_enable',
        containers: containers
    };
    if (token) payload.csrf_token = token;

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
        if (resp && resp.success) {
            homepageShowNotification('success', resp.message || 'Discovery enabled successfully.');
            setTimeout(function() { location.reload(); }, 1200);
        } else {
            homepageShowNotification('error', 'Batch enable failed: ' + (resp.error || 'Unknown error'));
        }
    }, 'json').fail(function() {
        homepageShowNotification('error', 'Request failed: unable to connect to plugin backend.');
    });
}

/**
 * Batch disable discovery for selected containers.
 */
function homepageBatchDisable() {
    var containers = homepageGetSelectedContainers();
    if (!containers.length) return;

    if (!confirm('⚠️ Disable Homepage Discovery for ' + containers.length + ' container(s)?\n\nAll Homepage labels will be removed. Backup snapshots will be saved so you can restore them at any time.')) {
        return;
    }

    var token = homepageGetCsrfToken();
    var payload = {
        action: 'batch_disable',
        containers: containers
    };
    if (token) payload.csrf_token = token;

    $.post('/plugins/homepage-labels/scripts/apply_labels.php', payload, function(resp) {
