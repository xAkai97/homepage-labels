    /* --- Interactive Field Rows --- */
    .homepage-fields-grid {
        display: flex;
        flex-direction: column;
        gap: 0.8em;
    }
    .homepage-field-row {
        display: flex;
        align-items: flex-start;
        padding: 0.95em 1.2em;
        border-radius: 0.55em;
        border: 1px solid rgba(120, 120, 120, 0.2);
