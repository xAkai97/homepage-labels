<!-- JavaScript -->
<script>
var csrf_token = "<?= htmlspecialchars($var['csrf_token'] ?? $_SESSION['csrf_token'] ?? '') ?>";
var isEmbedMode = <?= $isEmbed ? 'true' : 'false' ?>;

function homepageGetCsrfToken() {
    var m = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/);
    var cookieToken = m ? decodeURIComponent(m[1]) : '';
    return (typeof csrf_token !== 'undefined' && csrf_token)
        ? csrf_token
        : (window.csrf_token || (typeof $.cookie === 'function' ? $.cookie('csrf_token') : '') || cookieToken || $('#homepage-csrf-token').val() || $('input[name="csrf_token"]').val() || '');
}

var currentSortMode = 'active_first';
var homepageFormDirty = false;

$(function() {
    // Close dropdowns on outside click
    $(document).on('click', function(e) {
        if (!$(e.target).closest('.homepage-dropdown-wrap').length) {
            $('.homepage-dropdown-menu').hide();
        }
    });

    // Initialize tablesorter on dashboard table
    if ($('#homepage-labels-dashboard').length) {
        $('#homepage-labels-dashboard').tablesorter({
            headers: { 0: { sorter: false }, 7: { sorter: false } },
            selectorHeaders: '> thead th',
            cssInfoBlock: 'homepage-group-header-row'
        });
        homepageInitColumnResizing();
    }

    // Initialize live discovery preview if editor is loaded
    if ($('#homepage-live-yaml').length) {
        var initialIcon = $('input[name="labels[homepage.icon]"]').val();
        if (initialIcon) {
            homepageUpdateIconPreview(initialIcon);
        }
        homepageUpdateLivePreview();
        homepageRefreshAllBadges();
    }

    // Track unsaved changes
    $(window).on('beforeunload', function() {
        if (homepageFormDirty) {
            return 'You have unsaved changes in the label editor.';
        }
    });
});

/**
 * Toggle dropdown menu open / close.
 */
function homepageToggleDropdown(type, event) {
    event.stopPropagation();
    var $target = $('#homepage-' + type + '-menu');
    var isVisible = $target.is(':visible');
    $('.homepage-dropdown-menu').hide();
    if (!isVisible) {
        $target.slideDown(120);
    }
}

/**
 * Reset all multi-select filter checkboxes.
 */
function homepageResetFilters() {
    $('.homepage-filter-cb').prop('checked', false);
    homepageFilterChanged();
}

/**
 * Handle any checkbox state change in the multi-select filter dropdown.
 */
function homepageFilterChanged() {
    var selectedStatuses = [];
    var selectedFeatures = [];
    var selectedGroups = [];

    $('.homepage-filter-cb:checked').each(function() {
        var type = $(this).data('filter-type');
        var val = $(this).val();
        if (type === 'status') selectedStatuses.push(val);
        else if (type === 'feature') selectedFeatures.push(val);
        else if (type === 'group') selectedGroups.push(val);
    });

    var totalSelected = selectedStatuses.length + selectedFeatures.length + selectedGroups.length;
    var $filterBtn = $('#homepage-filter-dropdown-wrap .homepage-btn--filter');
    if (totalSelected === 0) {
        $('#filter-btn-label').text('Filter: All (' + $('.homepage-row').length + ')');
        $filterBtn.removeClass('has-active-filters');
    } else {
        var labels = [];
        if (selectedStatuses.length) labels.push(selectedStatuses.map(function(s) { return s.charAt(0).toUpperCase() + s.slice(1); }).join('/'));
        if (selectedFeatures.length) labels.push(selectedFeatures.length + ' Feature' + (selectedFeatures.length > 1 ? 's' : ''));
        if (selectedGroups.length) labels.push(selectedGroups.length + ' Group' + (selectedGroups.length > 1 ? 's' : ''));
        $('#filter-btn-label').text('Filter: ' + labels.join(', '));
        $filterBtn.addClass('has-active-filters');
    }

    // Sync 1-click status pills
    var activeChecked = $('#filter-status-active').is(':checked');
    var inactiveChecked = $('#filter-status-inactive').is(':checked');
    var widgetChecked = $('#filter-feature-widget').is(':checked');
    $('.homepage-filter-pill').removeClass('active');
    if (activeChecked && !inactiveChecked && !widgetChecked && selectedGroups.length === 0) {
        $('.homepage-filter-pill[data-filter="active"]').addClass('active');
    } else if (inactiveChecked && !activeChecked && !widgetChecked && selectedGroups.length === 0) {
        $('.homepage-filter-pill[data-filter="inactive"]').addClass('active');
    } else if (widgetChecked && !activeChecked && !inactiveChecked && selectedGroups.length === 0) {
        $('.homepage-filter-pill[data-filter="widget"]').addClass('active');
    } else if (totalSelected === 0) {
        $('.homepage-filter-pill[data-filter="all"]').addClass('active');
    }

    homepageApplyFilters();
}

/**
 * 1-Click status filter pill selector.
 */
function homepageSetQuickFilter(filter, el) {
    $('.homepage-filter-pill').removeClass('active');
    $(el).addClass('active');

    // Clear all status & feature checkboxes
    $('.homepage-filter-cb').prop('checked', false);

    if (filter === 'active') {
        $('#filter-status-active').prop('checked', true);
    } else if (filter === 'inactive') {
        $('#filter-status-inactive').prop('checked', true);
    } else if (filter === 'widget') {
        $('#filter-feature-widget').prop('checked', true);
    }

    homepageFilterChanged();
}

/**
 * Handle Sort Selection from dropdown.
 */
function homepageSelectSort(sortMode, labelText, itemElement) {
    currentSortMode = sortMode;
    $('#sort-btn-label').text(labelText);
    $('#homepage-sort-menu .homepage-dropdown-item').removeClass('active');
    $(itemElement).addClass('active');
    $('#homepage-sort-menu').hide();
    homepageApplySorting();
}

/**
 * Re-order dashboard rows based on active sort mode.
 */
function homepageApplySorting() {
    var $tbody = $('#homepage-labels-dashboard tbody');
    var $activeHeader = $('#homepage-labels-dashboard .homepage-group-header-row--active');
    var $inactiveHeader = $('#homepage-labels-dashboard .homepage-group-header-row--inactive');

    // Persist headers across sort mode switches so they aren't lost when switching from flat sort
    if ($activeHeader.length) {
        window.$hpActiveHeader = $activeHeader.detach();
    }
    if ($inactiveHeader.length) {
        window.$hpInactiveHeader = $inactiveHeader.detach();
    }
    var $savedActive = window.$hpActiveHeader || $activeHeader;
    var $savedInactive = window.$hpInactiveHeader || $inactiveHeader;

    var $rows = $('.homepage-row').detach();

    if (currentSortMode === 'active_first') {
        // Grouped mode: Active A-Z first, then Inactive A-Z
        var activeRows = $rows.filter('[data-active="1"]').get().sort(function(a, b) {
            return ($(a).data('name') || '').localeCompare($(b).data('name') || '');
        });
        var inactiveRows = $rows.filter('[data-active="0"]').get().sort(function(a, b) {
            return ($(a).data('name') || '').localeCompare($(b).data('name') || '');
        });

        $tbody.empty();
        if ($savedActive && $savedActive.length) $tbody.append($savedActive);
        $tbody.append(activeRows);
        if ($savedInactive && $savedInactive.length) $tbody.append($savedInactive);
        $tbody.append(inactiveRows);

    } else {
        // Flat sort across all containers
        var sortedRows = $rows.get().sort(function(a, b) {
            var aName = ($(a).data('name') || '').toString();
            var bName = ($(b).data('name') || '').toString();
            var aGroup = ($(a).data('group-name') || '').toString();
            var bGroup = ($(b).data('group-name') || '').toString();
            var aLabels = parseInt($(a).data('label-count') || 0);
            var bLabels = parseInt($(b).data('label-count') || 0);

            if (currentSortMode === 'name_asc') {
                return aName.localeCompare(bName);
            } else if (currentSortMode === 'name_desc') {
                return bName.localeCompare(aName);
            } else if (currentSortMode === 'group_asc') {
                if (aGroup === bGroup) return aName.localeCompare(bName);
                if (!aGroup) return 1;
                if (!bGroup) return -1;
                return aGroup.localeCompare(bGroup);
            } else if (currentSortMode === 'labels_desc') {
                if (bLabels !== aLabels) return bLabels - aLabels;
                return aName.localeCompare(bName);
            }
            return 0;
        });

        $tbody.empty().append(sortedRows);
    }

    homepageApplyFilters();
}

/**
 * Realtime Search input handler with micro-debounce and clear button sync.
 */
var homepageSearchTimer = null;
function homepageSearch(query) {
    var q = (query || '').trim();
    if (q) {
        $('#homepage-search-clear').show();
    } else {
        $('#homepage-search-clear').hide();
    }
    clearTimeout(homepageSearchTimer);
    homepageSearchTimer = setTimeout(function() {
        homepageApplyFilters();
    }, 150);
}

