    var isMasked = ($sel.val() === 'true');
    var $row = $sel.closest('.homepage-field-row');
    $row.find('input[type="checkbox"][name^="masks"]').prop('checked', isMasked);
    var $input = $row.find('input[name^="labels["]');
    if (isMasked) {
        if ($input.attr('type') !== 'password' && !$input.hasClass('homepage-secret-revealed')) {
