require_once '/usr/local/emhttp/plugins/homepage-labels/include/view_components.php';

// Ensure Unraid emhttp runtime variables are initialized
if (!isset($var) || !is_array($var)) {
    if (isset($GLOBALS['var']) && is_array($GLOBALS['var'])) {
        $var = &$GLOBALS['var'];
    } elseif (file_exists('/var/local/emhttp/var.ini')) {
        $var = @parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW) ?: [];
    } else {
        $var = [];
    }
}
if (session_status() === PHP_SESSION_NONE) {
    @session_start();
}
if (empty($var['csrf_token'])) {
    $var['csrf_token'] = $GLOBALS['var']['csrf_token']
        ?? $_SESSION['csrf_token']
        ?? (file_exists('/var/local/emhttp/var.ini') ? (@parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW)['csrf_token'] ?? null) : null)
        ?? $_COOKIE['csrf_token']
        ?? '';
}

// Delegate Global Settings tab & POST actions to HomepageLabelsSettings.page
$isSettingsTab = (($_GET['tab'] ?? '') === 'settings') ||
    (($_SERVER['REQUEST_METHOD'] ?? '') === 'POST' && in_array($_POST['action'] ?? '', ['save_settings', 'download_support_bundle'], true));
if ($isSettingsTab) {
    $settingsPageFile = is_file(__DIR__ . '/HomepageLabelsSettings.page')
        ? (__DIR__ . '/HomepageLabelsSettings.page')
        : '/usr/local/emhttp/plugins/homepage-labels/HomepageLabelsSettings.page';
    if (is_file($settingsPageFile)) {
        ob_start();
        require $settingsPageFile;
        $settingsPageOutput = ob_get_clean();
        echo preg_replace('/\A.*?\R---\R/s', '', (string)$settingsPageOutput);
        return;
    }
}

// Load settings
$settings = loadPluginSettings();
$fontScale = isset($settings['UI_FONT_SCALE']) ? $settings['UI_FONT_SCALE'] : '100';
$retentionHours = isset($settings['BACKUP_RETENTION_HOURS']) ? intval($settings['BACKUP_RETENTION_HOURS']) : 24;
purgeExpiredBackups($retentionHours);

// Load presets
$allPresetsData = loadAllPresets();
$presets = $allPresetsData['presets'];

// Determine current view mode
$editContainer = isset($_GET['edit']) ? $_GET['edit'] : null;
$isEmbed = isset($_GET['embed']) && $_GET['embed'] === '1';
