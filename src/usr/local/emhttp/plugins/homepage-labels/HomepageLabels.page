        align-items: center;
        gap: 6px;
        background: rgba(230, 81, 0, 0.06);
        border: 1px solid rgba(230, 81, 0, 0.2);
        padding: 3px 10px;
        border-radius: 4px;
    }
    .homepage-key-hint strong {
        color: var(--hp-primary, #e65100);
