    .homepage-btn--field-config {
        background: rgba(120, 120, 120, 0.12) !important;
        color: inherit !important;
        border: 1px solid rgba(120, 120, 120, 0.28) !important;
        padding: 0.38em 0.75em !important;
        border-radius: 0.4em !important;
        cursor: pointer !important;
        font-size: 0.88em !important;
        font-weight: 500 !important;
        transition: all 0.15s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 0.4em !important;
    }
    .homepage-btn--field-config:hover {
        background: rgba(120, 120, 120, 0.25) !important;
        border-color: rgba(120, 120, 120, 0.45) !important;
    }
    .homepage-btn--field-config.active {
        background: rgba(230, 81, 0, 0.18) !important;
        color: #e65100 !important;
        border-color: #e65100 !important;
