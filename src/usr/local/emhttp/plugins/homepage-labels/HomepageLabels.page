/**
 * Toggle secret field reveal / conceal between password dots and clear text.
 */
function homepageToggleSecretVisibility(btn) {
    var $btn = $(btn);
    var $wrap = $btn.closest('.homepage-field-input-wrap, .homepage-custom-main-wrap');
    var $input = $wrap.find('input[type="password"], input[type="text"].homepage-secret-input, input.custom-val');

    if (!$input.length) {
        $input = $wrap.find('input[name^="labels["], input.custom-val');
    }
    if (!$input.length) return;

    var currentType = $input.attr('type');
    if (currentType === 'password') {
        $input.attr('type', 'text').addClass('homepage-secret-revealed');
        $btn.find('i').removeClass('fa-eye').addClass('fa-eye-slash');
        $btn.attr('title', 'Hide secret');
    } else {
        $input.attr('type', 'password').removeClass('homepage-secret-revealed');
        $btn.find('i').removeClass('fa-eye-slash').addClass('fa-eye');
        $btn.attr('title', 'Show secret');
    }
}

/**
 * Synchronize inline mask checkbox with drawer select for standard fields.
 */
function homepageSyncMask(cb) {
    var $cb = $(cb);
    var isChecked = $cb.is(':checked');
    var $row = $cb.closest('.homepage-field-row');
    $row.find('.cfg-attr-mask').val(isChecked ? 'true' : 'false');
    var $input = $row.find('input[name^="labels["]');
    if (isChecked) {
        if ($input.attr('type') !== 'password' && !$input.hasClass('homepage-secret-revealed')) {
            $input.attr('type', 'password');
        }
    }
    homepageOnFieldChange();
}

/**
 * Synchronize drawer select with inline mask checkbox for standard fields.
 */
