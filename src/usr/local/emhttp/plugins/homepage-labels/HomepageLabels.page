/**
 * Toggle widget configuration section checkbox (auto expand/collapse).
 */
function homepageToggleWidgetSection(checked) {
    if (checked) {
        homepageForceExpandSection('widget');
        // Activate recommended widget fields
        $('#widget-recommended-fields .homepage-field-row').each(function() {
            homepageActivateField(this, true);
        });

        // Auto-fill widget.type if empty
        var $wType = $('input[name="labels[homepage.widget.type]"]');
        if ($wType.length && (!$wType.val() || !$wType.val().trim())) {
            var defType = $wType.data('default') || '';
            if (defType) $wType.val(defType);
        }

        // Auto-fill widget.url if empty
        var $wUrl = $('input[name="labels[homepage.widget.url]"]');
        if ($wUrl.length && (!$wUrl.val() || !$wUrl.val().trim())) {
            var defUrl = $wUrl.data('default') || $('input[name="labels[homepage.href]"]').val() || '';
            if (defUrl) $wUrl.val(defUrl);
        }

        // Focus first empty active input in widget section (e.g. API key)
        var $firstEmpty = $('#section-widget .homepage-field-row.homepage-field--active input:visible, #section-widget .homepage-field-row.homepage-field--active select:visible').filter(function() {
            return !$(this).val() || !$(this).val().trim();
        }).first();
        if ($firstEmpty.length) {
            $firstEmpty.focus();
        }
    } else {
        // Deactivate all active widget fields
        $('#section-widget .homepage-field-row.homepage-field--active').each(function() {
            $(this).removeClass('homepage-field--active').addClass('homepage-field--dimmed');
            $(this).find('.homepage-btn--remove-field, .homepage-btn--field-config, .homepage-btn--secret-toggle, .homepage-mask-toggle').hide();
            $(this).find('.homepage-dimmed-hint').show();
            $(this).find('input, select').prop('disabled', true).val('');
            $(this).find('select').prop('selectedIndex', 0);
        });
        homepageForceCollapseSection('widget');
    }
    homepageOnFieldChange();
    homepageUpdateBadge('widget');
}

/* =========================================================================
   INTERACTIVE FIELD LIFECYCLE (ACTIVE VS DIMMED)
   ========================================================================= */

/**
 * Activate a dimmed field row (click to enable).
 */
function homepageActivateField(rowElement, preventFocus) {
    var $row = $(rowElement);
    if ($row.hasClass('homepage-field--active')) {
        return; // Already active
    }

    $row.removeClass('homepage-field--dimmed').addClass('homepage-field--active');
    $row.find('.homepage-btn--remove-field, .homepage-btn--field-config, .homepage-btn--secret-toggle, .homepage-mask-toggle').show();
    $row.find('.homepage-dimmed-hint').hide();
    var $inputs = $row.find('input, select').prop('disabled', false);

    // Auto-fill default value if input is currently empty
    $inputs.each(function() {
        if (!$(this).val() && $(this).data('default')) {
            $(this).val($(this).data('default'));
        }
    });

    var sectionId = $row.data('section');
    if (sectionId === 'widget') {
        $('#enable-widget').prop('checked', true);
    }
    if (sectionId) {
        homepageUpdateBadge(sectionId);
    }

    if (!preventFocus) {
        $row.find('input[type="text"], input[type="password"], input[type="number"], select').first().focus();
    }

    homepageOnFieldChange();
}

/**
 * Deactivate an active optional field (click red remove button).
 */
function homepageDeactivateField(btnElement) {
    var $row = $(btnElement).closest('.homepage-field-row');
    if ($row.data('required') == 1) {
        return; // Required fields cannot be deactivated
    }

    // Clear input values
    $row.find('input[type="text"], input[type="password"], input[type="number"]').val('');
    $row.find('select').each(function() {
        $(this).prop('selectedIndex', 0);
    });

    $row.removeClass('homepage-field--active').addClass('homepage-field--dimmed');
    $row.find('.homepage-btn--remove-field, .homepage-btn--field-config, .homepage-btn--secret-toggle, .homepage-mask-toggle').hide();
    $row.find('.homepage-dimmed-hint').show();
    $row.find('input, select').prop('disabled', true);
    $row.find('.homepage-field-config-drawer').slideUp(100);
    $row.find('.homepage-btn--field-config').removeClass('active');

    // Clear icon preview if applicable
    if ($row.data('target') === 'homepage.icon') {
        $('#icon-preview').empty();
    }

    var sectionId = $row.data('section');
    if (sectionId) {
        homepageUpdateBadge(sectionId);
    }

    homepageOnFieldChange();
}

/**
 * Toggle the advanced Unraid XML <Config> attributes drawer for a field row.
 */
function homepageToggleFieldConfig(btn) {
    var $btn = $(btn);
    var $row = $btn.closest('.homepage-field-row');
    var $drawer = $row.find('.homepage-field-config-drawer');

    // If row is dimmed, activate it first
    if ($row.hasClass('homepage-field--dimmed')) {
        homepageActivateField($row[0], true);
    }

    $drawer.stop(true, true).slideToggle(160, function() {
        if ($drawer.is(':visible')) {
            $btn.addClass('active');
        } else {
            $btn.removeClass('active');
        }
    });
}

/**
 * Toggle the advanced Unraid XML <Config> attributes drawer for a custom row.
 */
function homepageToggleCustomConfig(btn) {
    var $btn = $(btn);
    var $row = $btn.closest('.homepage-custom-row');
    var $drawer = $row.find('.homepage-custom-config-drawer');

    $drawer.stop(true, true).slideToggle(160, function() {
        if ($drawer.is(':visible')) {
            $btn.addClass('active');
        } else {
            $btn.removeClass('active');
        }
    });
}

/**
 * Toggle all advanced XML <Config> drawers simultaneously.
 */
function homepageToggleAdvancedXmlMode() {
    var $btn = $('#btn-toggle-advanced-xml');
    var $activeRows = $('.homepage-field-row.homepage-field--active, .homepage-custom-row');
    var $drawers = $activeRows.find('.homepage-field-config-drawer, .homepage-custom-config-drawer');
    var $configBtns = $activeRows.find('.homepage-btn--field-config');

    // Check if any drawer in active rows is currently hidden
    var hasHidden = false;
    $drawers.each(function() {
        if (!$(this).is(':visible')) {
            hasHidden = true;
            return false;
        }
    });

    if (hasHidden) {
        $drawers.slideDown(180);
        $configBtns.addClass('active');
        $btn.addClass('active');
    } else {
        $drawers.slideUp(180);
        $configBtns.removeClass('active');
        $btn.removeClass('active');
    }
}

/**
 * Recalculate and update the active counter badge for a section.
 */
function homepageUpdateBadge(sectionId) {
    var $section = $('#section-' + sectionId);
    if (!$section.length) return;

    var activeCount = 0;
    var totalCount = 0;

    if (sectionId === 'widget') {
        $section.find('.homepage-field-row').each(function() {
            totalCount++;
            if ($(this).hasClass('homepage-field--active')) {
                var val = $(this).find('input[type="text"], input[type="password"], input[type="number"], select').val();
                if (val || $(this).data('required') == 1) {
                    activeCount++;
                }
            }
        });

        // Automatically sync Enable Widget checkbox with active field count
        if (activeCount > 0) {
            $('#enable-widget').prop('checked', true);
        } else {
            $('#enable-widget').prop('checked', false);
        }
    } else if (sectionId === 'custom') {
        var customCount = 0;
        $('.homepage-custom-row').each(function() {
            var k = $(this).find('.custom-key').val();
            var v = $(this).find('.custom-val').val();
            if (k && k.trim() || v && v.trim()) {
                customCount++;
            }
        });
        $('#badge-custom').html('<span class="active-num">' + customCount + '</span> Active');
        return;
    } else {
        $section.find('.homepage-field-row').each(function() {
            totalCount++;
            if ($(this).hasClass('homepage-field--active')) {
                activeCount++;
            }
        });
    }

    $('#badge-' + sectionId + ' .active-num').text(activeCount);
}

/**
 * Recalculate all section badges.
 */
function homepageRefreshAllBadges() {
    homepageUpdateBadge('core');
    homepageUpdateBadge('display');
    homepageUpdateBadge('health');
    homepageUpdateBadge('widget');
    homepageUpdateBadge('custom');
}

